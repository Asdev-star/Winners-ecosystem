{
  "name": "winners-app",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry.js",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "socket.io-client",
          "cosmiconfig"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "postinstall": "node ./scripts/repair-rngh.cjs",
    "eas-build-pre-build": "bash ./eas-hooks/prebuild-android.sh"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
