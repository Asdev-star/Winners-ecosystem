    "@react-navigation/native-stack": "^7.14.7",
    "@stripe/stripe-react-native": "^0.39.0",
    "cosmiconfig": "^9.0.1",
    "expo": "~55.0.0",
    "expo-auth-session": "~55.0.9",
    "expo-av": "~15.0.0",
    "expo-build-properties": "~55.0.10",
    "expo-camera": "~16.0.0",
    "expo-constants": "~55.0.9",
    "expo-device": "~7.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-haptics": "~14.0.0",
