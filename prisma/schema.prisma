// prisma/schema.prisma
// Winners Ecosystem — Complete Schema
// Phase 1: Core Engine + Phase 2: Community Layer V1.2 (Groups)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE ENGINE — PHASE 1
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                   String    @id @default(cuid())
  name                 String
  plan                 Plan      @default(FREE)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  timezone             String    @default("UTC")
  currency             String    @default("USD")
  fiscalMonth          Int       @default(1)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  users           User[]
  invites         Invite[]
  revenueRecords  RevenueRecord[]
  analyticsEvents AnalyticsEvent[]
  referralCredits ReferralCredit[]
  posts           Post[]
  groups          Group[]
  privacyAcknowledgments PrivacyAcknowledgment[]
  courses             Course[]
  conversations       Conversation[]
  liveSpaces         LiveSpace[]

  @@map("tenants")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  name             String
  password         String
  role             Role      @default(MEMBER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String?
  twoFactorBackup  String[]  @default([])

  tenant              Tenant               @relation(fields: [tenantId], references: [id])
  passwordResetTokens PasswordResetToken[]
  referralsGiven      Referral[]           @relation("ReferrerRelation")
  referralsReceived   Referral[]           @relation("ReferredRelation")
  referralCredits     ReferralCredit[]
  twoFactorOTPs       TwoFactorOTP[]
  posts               Post[]               @relation("PostAuthor")
  comments            Comment[]            @relation("CommentAuthor")
  likes               Like[]
  followers           Follow[]             @relation("Followers")
  following           Follow[]             @relation("Following")
  createdGroups       Group[]              @relation("GroupCreator")
  groupMemberships    GroupMember[]
  privacyAcknowledgment PrivacyAcknowledgment?
  instructedCourses    Course[]         @relation("CourseInstructor")
  courseEnrollments    Enrollment[]     @relation("CourseEnrollment")
  lessonProgress       LessonProgress[] @relation("LessonProgress")
  courseCertificates   Certificate[]    @relation("CourseCertificate")
  courseReviews        Review[]         @relation("CourseReview")
  createdConversations Conversation[]   @relation("ConversationCreator")
  messages             Message[]        @relation("MessageSender")
  conversationParticipations ConversationParticipant[]
  messageReads         MessageRead[]
  hostedSpaces         LiveSpace[]          @relation("LiveSpaceHost")
  spaceParticipations  LiveSpaceParticipant[]
  spaceSpeakers       LiveSpaceSpeaker[]
  opportunities        Opportunity[]
  subscriberSubscriptions CreatorSubscription[] @relation("Subscriber")
  creatorSubscriptions  CreatorSubscription[] @relation("Creator")
  creatorTier          CreatorTier[]
  challengeSubmissions CommunityChallengeSubmission[]
  challengeWins       CommunityChallengeWinner[]
  savedPosts         SavedPost[]
  endorsedSkills     SkillEndorsement[]  @relation("Endorsee")
  givenEndorsements  SkillEndorsement[]  @relation("Endorser")
  learningTracks     GroupLearningTrack[] @relation("LearningTrackCreator")
  novaSkills         NovaSkillDetection[] @relation("UserNovaSkills")
  postReactions      PostReaction[]

  // SAGE Super-Intelligence V2 Relations
  flashcards         Flashcard[]
  flashcardReviews   FlashcardReview[]
  mentorProfile      Mentor?
  mentorSessions     MentorSession[] @relation("MentorSessionLearner")
  hostedLiveSessions LiveSession[]
  attendedSessions   LiveSessionAttendee[]
  learnerProfile    LearnerProfile?

  // Diaspora Directory fields
  country             String?
  city                String?
  bio                 String?
  skills              String[] // Array of skills for directory
  industry            String?
  isPublicProfile     Boolean   @default(true)
  profileViews        Int       @default(0)
  metadata            Json      @default("{}")
  
  // Trust Score system (0-100)
  trustScore          Int       @default(50)
  trustScoreTier      String    @default("SILVER") // BRONZE, SILVER, GOLD, PLATINUM
  trustScoreUpdatedAt DateTime?

  // Open to Opportunities signal (V2 feature)
  openToOpportunities Boolean   @default(false)
  opportunityStatus   String?   // LOOKING_FOR_WORK, OPEN_TO_COLLAB, HIRING
  opportunityBio     String?   // Brief description of what user is open to

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model PrivacyAcknowledgment {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String   @unique
  policyVersion  String
  acknowledgedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([acknowledgedAt(sort: Desc)])
  @@map("privacy_acknowledgments")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model TwoFactorOTP {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("two_factor_otps")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Invite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      Role     @default(MEMBER)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("invites")
}

model RevenueRecord {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Float
  currency    String   @default("USD")
  source      String
  description String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recordedAt])
  @@map("revenue_records")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  event     String   @default("unknown")
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([event])
  @@index([createdAt])
  @@map("analytics_events")
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referredId    String?
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  creditAwarded Boolean        @default(false)
  createdAt     DateTime       @default(now())
  convertedAt   DateTime?

  referrer User  @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referred User? @relation("ReferredRelation", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

model ReferralCredit {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  amount    Float
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("referral_credits")
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  userEmail String?
  userName  String?
  action    String
  category  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ChangelogType @default(FEATURE)
  version     String?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  published   Boolean       @default(true)

  @@index([publishedAt(sort: Desc)])
  @@map("changelog_entries")
}

enum ChangelogType {
  FEATURE
  BUGFIX
  IMPROVEMENT
  COMING_SOON
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.0
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id            String    @id @default(cuid())
  tenantId      String
  authorId      String
  content       String
  mediaUrl      String?
  mediaType     String?
  linkUrl       String?
  linkTitle     String?
  edited        Boolean   @default(false)
  isPinned      Boolean   @default(false)
  engagementScore Int     @default(0)
  quotedPostId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  groupId       String?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  author   User      @relation("PostAuthor", fields: [authorId], references: [id])
  comments Comment[]
  likes    Like[]
  reactions PostReaction[]
  tags     PostTag[]
  group    Group?    @relation("GroupPosts", fields: [groupId], references: [id])
  savedPosts SavedPost[]
  novaSkills  NovaSkillDetection[]
  quotedPost      Post?      @relation("SelfQuotedPost", fields: [quotedPostId], references: [id])
  quotedByPosts   Post[]     @relation("SelfQuotedPost")
  quotingPosts    QuotePost[] @relation("QuotingPost")
  quotedInPosts   QuotePost[] @relation("QuotedPost")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([tenantId, isPinned])
  @@index([groupId])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, commentId])
  @@index([postId])
  @@index([commentId])
  @@map("likes")
}

// Six-reaction system for community posts
model PostReaction {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  reaction  String   // like, celebrate, support, insightful, funny, curious
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, reaction])
  @@index([postId])
  @@index([reaction])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.2: GROUPS
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  coverImage  String?
  isPrivate   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                   Tenant              @relation(fields: [tenantId], references: [id])
  createdBy                User                @relation("GroupCreator", fields: [createdById], references: [id])
  members                  GroupMember[]
  posts                    Post[]              @relation("GroupPosts")
  learningTracks           GroupLearningTrack[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(cuid())
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

// Group Learning Tracks (Facebook Events adapted for professional development)
model GroupLearningTrack {
  id          String   @id @default(cuid())
  groupId     String
  title       String
  description String?
  currentWeek Int      @default(1)
  totalWeeks  Int      @default(4)
  startDate   DateTime
  endDate     DateTime
  courseId    String?  // optional link to Academy course
  participants Int    @default(0)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  group       Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator     User     @relation("LearningTrackCreator", fields: [createdById], references: [id])

  @@index([groupId])
  @@index([createdById])
  @@map("group_learning_tracks")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.4: LIVE SPACES
// ─────────────────────────────────────────────────────────────────────────────

model LiveSpace {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  hostId      String
  status      LiveSpaceStatus @default(SCHEDULED)
  scheduledAt DateTime?
  startedAt   DateTime?
  endedAt     DateTime?
  maxSpeakers Int      @default(6)
  maxListeners Int     @default(500)
  isRecorded  Boolean  @default(false)
  recordingUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant              @relation(fields: [tenantId], references: [id])
  host        User                @relation("LiveSpaceHost", fields: [hostId], references: [id])
  participants LiveSpaceParticipant[]
  speakers    LiveSpaceSpeaker[]

  @@index([tenantId])
  @@index([hostId])
  @@index([status])
  @@map("live_spaces")
}

model LiveSpaceParticipant {
  id         String   @id @default(cuid())
  spaceId    String
  userId     String
  role       LiveSpaceParticipantRole @default(LISTENER)
  joinedAt   DateTime @default(now())
  leftAt     DateTime?

  space LiveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@index([userId])
  @@map("live_space_participants")
}

model LiveSpaceSpeaker {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  isMuted   Boolean  @default(false)
  isInvited Boolean  @default(false)
  joinedAt  DateTime @default(now())

  space LiveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@map("live_space_speakers")
}

// ─── Opportunity Board ───────────────────────────────────────────────────────────

model Opportunity {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  description String   @db.Text
  type        OpportunityType
  category    String   // "job", "collab", "mentorship", "investment"
  budget      String?  // e.g., "$5000", "negotiable", "volunteer"
  skills      String[]
  location    String?  // remote, specific country/city
  status      OpportunityStatus @default(ACTIVE)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expiresAt   DateTime?

  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@map("opportunities")
}

// ─── Community Notifications ──────────────────────────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  tenantId    String
  userId     String           // recipient
  actorId    String?          // who triggered it
  type       NotificationType // like | comment | follow | mention | skill_detected
  title      String
  body       String
  entityId   String?          // postId, commentId, etc.
  entityType String?          // post | comment | group | opportunity
  link       String?          // navigation link
  read       Boolean          @default(false)
  
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  
  @@index([userId, read])
  @@index([tenantId])
  @@map("notifications")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  SKILL_DETECTED
  OPPORTUNITY_MATCH
  TRUST_SCORE_UPDATE
  CHALLENGE_COMPLETE
  LOOP_ADVANCE
  SYSTEM
}

enum OpportunityType {
  JOB
  COLLABORATION
  MENTORSHIP
  INVESTMENT
}

enum OpportunityStatus {
  ACTIVE
  FILLED
  EXPIRED
  ARCHIVED
}

// ─── Creator Subscriptions ─────────────────────────────────────────────────────────

model CreatorSubscription {
  id              String   @id @default(cuid())
  subscriberId    String
  creatorId       String
  subscriber      User     @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator         User     @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  tier            String   // "basic", "pro", "premium"
  amount          Int      // amount in cents
  status          SubscriptionStatus @default(ACTIVE)
  startedAt       DateTime @default(now())
  expiresAt       DateTime?
  stripeSubId     String?  // Stripe subscription ID
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([subscriberId, creatorId])
  @@index([creatorId])
  @@index([subscriberId])
  @@map("creator_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

model CreatorTier {
  id          String   @id @default(cuid())
  creatorId   String
  tenantId    String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  benefits    String[] // benefits for this tier
  monthlyPrice Int     // monthly price in cents
  yearlyPrice  Int     // yearly price in cents
  isActive    Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([creatorId, name])
  @@index([tenantId])
  @@map("creator_tiers")
}

// ─── Community Challenges ───────────────────────────────────────────────────────────

model CommunityChallenge {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String
  category    String   // "content", "engagement", "creation", "growth"
  prize       String   // "credits", "badge", "featured", "subscription"
  prizeValue  Int      // amount of credits or badge name
  startsAt    DateTime
  endsAt      DateTime
  status      ChallengeStatus @default(ACTIVE)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  submissions CommunityChallengeSubmission[]
  winners     CommunityChallengeWinner[]

  @@index([tenantId, status])
  @@index([endsAt])
  @@map("community_challenges")
}

model CommunityChallengeSubmission {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  postId      String?
  content     String   @db.Text
  engagement  Int      @default(0) // likes + comments + shares
  
  createdAt   DateTime @default(now())

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId, engagement(sort: Desc)])
  @@map("challenge_submissions")
}

model CommunityChallengeWinner {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  rank        Int      // 1st, 2nd, 3rd
  prizeAwarded String
  
  createdAt   DateTime @default(now())

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, rank])
  @@map("challenge_winners")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V2.0: INTELLIGENT UPGRADE
// Skills Endorsement, NOVA Detection, Community Insights
// ─────────────────────────────────────────────────────────────────────────────

// Skills Endorsement System (LinkedIn-inspired)
model SkillEndorsement {
  id           String   @id @default(cuid())
  userId       String   // User being endorsed
  endorserId   String   // User giving endorsement
  skill        String
  weight       Float    @default(1.0) // Weight based on endorser's trust score
  createdAt    DateTime @default(now())

  endorsee    User     @relation("Endorsee", fields: [userId], references: [id], onDelete: Cascade)
  endorser    User     @relation("Endorser", fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([endorserId, userId, skill])
  @@index([userId, skill])
  @@index([endorserId])
  @@map("skill_endorsements")
}

// NOVA Skill Detection Results
model NovaSkillDetection {
  id          String   @id @default(cuid())
  postId      String
  userId      String
  skill       String
  confidence  Float    // 0-100
  category    String?  // 'technical', 'creative', 'business', 'soft', 'language'
  source      String   @default("post") // 'post', 'comment', 'voice', 'bio'
  loopStage   String?  // 'skill', 'course', 'income'
  isActioned  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User     @relation("UserNovaSkills", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, skill])
  @@index([postId])
  @@index([skill])
  @@index([userId])
  @@map("nova_skill_detections")
}

// Community Insights (NOVA's intelligence)
model CommunityInsight {
  id          String   @id @default(cuid())
  userId      String?
  type        String   // 'posting_momentum', 'skill_detected', 'opportunity_match', 'engagement_alert'
  title       String
  content     String   @db.Text
  metadata    Json?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("community_insights")
}

// Saved Posts (Bookmarks)
model SavedPost {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  isPublic  Boolean  @default(false) // Public bookmarks for social proof
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

// Quote-Share (X-inspired) - when users share with commentary
model QuotePost {
  id           String   @id @default(cuid())
  postId       String   // the quoting post
  quotedPostId String   // the original post being quoted
  createdAt    DateTime @default(now())

  post         Post     @relation("QuotingPost", fields: [postId], references: [id], onDelete: Cascade)
  quotedPost   Post     @relation("QuotedPost", fields: [quotedPostId], references: [id], onDelete: Cascade)

  @@unique([postId, quotedPostId])
  @@index([postId])
  @@index([quotedPostId])
  @@map("quote_posts")
}

// User Feed Preferences
model UserFeedPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  feedMode        String   @default("foryou") // 'foryou', 'following', 'intelligence'
  novaIntelligence Boolean  @default(true)
  quickPostEnabled Boolean @default(true)
  updatedAt       DateTime @updatedAt

  @@map("user_feed_preferences")
}

// Agentic Loop Tracking per User
model AgenticLoopProgress {
  id            String   @id @default(cuid())
  userId        String
  stage         Int      @default(1) // 1-7
  stageName     String   // 'skill_detection', 'learning', 'certification', 'work_match', 'contract', 'vendor', 'compound'
  currentStage  String?  // 'community', 'academy', 'work', 'market', 'compound' - for display
  postsCount    Int      @default(0)
  skillsDetected Int     @default(0)
  coursesTaken  Int      @default(0)
  contractsWon  Int      @default(0)
  lastActivity  DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([userId])
  @@index([userId])
  @@map("agentic_loop_progress")
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  VOTING
  COMPLETED
  CANCELLED
}

enum LiveSpaceStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum LiveSpaceParticipantRole {
  HOST
  SPEAKER
  LISTENER
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.3: DIRECT MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id          String      @id @default(cuid())
  tenantId    String
  createdById String
  isGroup     Boolean     @default(false)
  title       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  createdBy  User        @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages    Message[]

  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([createdById])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  lastReadAt     DateTime  @default(now())
  joinedAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType @default(TEXT)
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User             @relation("MessageSender", fields: [senderId], references: [id])
  reads        MessageRead[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

model MessageRead {
  id          String   @id @default(cuid())
  messageId   String
  userId      String
  readAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}

// PHASE 3 - WINNERS ACADEMY

model Course {
  id           String      @id @default(cuid())
  tenantId     String
  instructorId String
  title        String
  slug         String
  description  String
  about        String?
  thumbnail    String?
  previewVideo String?
  category     String
  level        CourseLevel @default(BEGINNER)
  price        Float       @default(0)
  currency     String      @default("USD")
  published    Boolean     @default(false)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]

  // SAGE Super-Intelligence V2 Relations
  flashcards        Flashcard[]
  knowledgeGraph   KnowledgeGraphNode[]
  mentorSessions   MentorSession[]
  liveSessions    LiveSession[]

  @@unique([tenantId, slug])
  @@index([tenantId, published])
  @@index([instructorId])
  @@index([category])
  @@map("courses")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Module {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  title       String
  description String?
  content     String?
  videoUrl    String?
  duration    Int?
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  module   Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([moduleId, order])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(cuid())
  courseId        String
  userId          String
  status          EnrollmentStatus @default(ACTIVE)
  paidAmount      Float            @default(0)
  stripePaymentId String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  course      Course           @relation(fields: [courseId], references: [id])
  user        User             @relation("CourseEnrollment", fields: [userId], references: [id])
  progress    LessonProgress[]
  certificate Certificate?

  @@unique([courseId, userId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REFUNDED
  CANCELLED
}

model LessonProgress {
  id           String    @id @default(cuid())
  enrollmentId String
  lessonId     String
  userId       String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  watchedSecs  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User       @relation("LessonProgress", fields: [userId], references: [id])

  @@unique([enrollmentId, lessonId])
  @@index([userId])
  @@map("lesson_progress")
}

model Certificate {
  id           String   @id @default(cuid())
  enrollmentId String   @unique
  courseId     String
  userId       String
  verifyToken  String   @unique @default(cuid())
  issuedAt     DateTime @default(now())

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  user       User       @relation("CourseCertificate", fields: [userId], references: [id])

  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

model Review {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation("CourseReview", fields: [userId], references: [id])

  @@unique([courseId, userId])
  @@index([courseId])
  @@map("reviews")
}

// ─── Quiz System ──────────────────────────────────────────────────────────────
model Quiz {
  id          String   @id @default(cuid())
  courseId    String
  moduleId    String?
  title       String
  description String?
  passingScore Int     @default(70)  // percentage required to pass
  timeLimit   Int?     // minutes, null = no limit
  shuffleQuestions Boolean @default(false)
  showResults Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id          String        @id @default(cuid())
  quizId      String
  question    String        @db.Text
  questionType QuestionType @default(MULTIPLE_CHOICE)
  options     Json          // array of option strings for MCQ
  correctAnswer String      // for MCQ: option text, for TRUE_FALSE: "true"/"false"
  explanation String?       @db.Text // shown after answer
  points      Int           @default(1)
  order       Int           @default(0)
  createdAt   DateTime      @default(now())

  quiz      Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "QuizQuestions")

  @@index([quizId])
  @@map("quiz_questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model QuizAttempt {
  id            String   @id @default(cuid())
  quizId        String
  userId        String
  score         Int      // raw score
  percentage    Float    // percentage score
  passed        Boolean
  answers       Json     // { questionId: selectedAnswer, isCorrect: boolean }[]
  timeTakenSecs Int?
  startedAt     DateTime @default(now())
  completedAt   DateTime?

  quiz     Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "QuizAttempts")

  @@unique([quizId, userId], name: "quiz_user_attempt") // one attempt per user per quiz
  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

// ─── SAGE Super-Intelligence V2 Models ────────────────────────────────────────
// REC 02: AI Flashcard Engine with Spaced Repetition
model Flashcard {
  id          String   @id @default(cuid())
  userId      String
  courseId    String?
  lessonId    String?
  front       String   @db.Text  // question/prompt
  back        String   @db.Text  // answer
  tags        String[] // topic tags for organization
  
  // Spaced repetition fields (SM-2 algorithm)
  easeFactor  Float    @default(2.5)    // SM-2 ease factor
  interval    Int      @default(0)       // days until next review
  repetitions Int      @default(0)       // successful reviews
  nextReview  DateTime @default(now())   // next scheduled review
  
  // Source tracking
  sourceType  String?   // "ai_generated", "user_created", "quiz_question"
  sourceId    String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reviews     FlashcardReview[]
  
  @@index([userId])
  @@index([courseId])
  @@index([nextReview])  // for fetching due cards
  @@map("flashcards")
}

// REC 02: Flashcard Review History
model FlashcardReview {
  id          String   @id @default(cuid())
  flashcardId String
  userId      String
  quality     Int      // 0-5 SM-2 quality rating
  reviewedAt  DateTime @default(now())
  
  flashcard   Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([flashcardId])
  @@index([userId])
  @@map("flashcard_reviews")
}

// REC 01: Knowledge Graph - Course concept relationships
model KnowledgeGraphNode {
  id          String   @id @default(cuid())
  courseId    String
  concept     String   // e.g., "React Hooks", "API Design"
  description String?  @db.Text
  importance  Int      @default(1)  // 1-5 node size
  xPos        Float?   // for visualization
  yPos        Float?
  
  createdAt   DateTime @default(now())
  
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  outgoing    KnowledgeGraphEdge[] @relation("EdgeFrom")
  incoming    KnowledgeGraphEdge[] @relation("EdgeTo")
  
  @@unique([courseId, concept])
  @@index([courseId])
  @@map("knowledge_graph_nodes")
}

model KnowledgeGraphEdge {
  id          String   @id @default(cuid())
  fromNodeId  String
  toNodeId    String
  relation    String   // "prerequisites", "related", "builds_on", "example_of"
  weight      Float    @default(1.0)
  
  fromNode    KnowledgeGraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode      KnowledgeGraphNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  
  @@unique([fromNodeId, toNodeId, relation])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("knowledge_graph_edges")
}

// REC 05: Mentor Network
model Mentor {
  id              String   @id @default(cuid())
  userId          String   @unique
  bio             String?  @db.Text
  expertise       String[] // skill areas
  availability    String   @default("available")  // available, limited, unavailable
  hourlyRate      Int?     // cents
  timezone        String?
  linkedInUrl     String?
  
  // Stats
  sessionsCompleted Int   @default(0)
  avgRating         Float @default(0)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions        MentorSession[]
  
  @@index([userId])
  @@map("mentors")
}

model MentorSession {
  id          String   @id @default(cuid())
  mentorId    String
  learnerId   String
  courseId    String?
  
  scheduledAt DateTime
  durationMin Int      @default(60)
  status      String   @default("scheduled")  // scheduled, completed, cancelled
  
  // Video/meeting
  meetingUrl  String?
  
  // Feedback
  learnerFeedback String? @db.Text
  mentorRating    Int?
  
  createdAt   DateTime @default(now())
  
  mentor      Mentor   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  learner     User     @relation("MentorSessionLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  
  @@index([mentorId])
  @@index([learnerId])
  @@map("mentor_sessions")
}

// REC 06: Live Learning Sessions
model LiveSession {
  id          String   @id @default(cuid())
  courseId    String?
  hostId      String
  title       String
  description String?  @db.Text
  
  scheduledAt DateTime
  durationMin Int      @default(60)
  status      String   @default("scheduled")  // scheduled, live, ended, cancelled
  
  // Streaming
  streamUrl   String?
  recordingUrl String?
  
  // Capacity
  maxParticipants Int @default(100)
  currentParticipants Int @default(0)
  
  // Type
  sessionType String   @default("workshop")  // workshop, qa, demo, cohort_call
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  host        User     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  attendees   LiveSessionAttendee[]
  
  @@index([hostId])
  @@index([courseId])
  @@index([status])
  @@map("live_sessions")
}

model LiveSessionAttendee {
  id          String   @id @default(cuid())
  sessionId   String
  userId      String
  joinedAt    DateTime @default(now())
  leftAt      DateTime?
  
  session     LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([sessionId, userId])
  @@index([sessionId])
  @@index([userId])
  @@map("live_session_attendees")
}

// SAGE Learner Profile - 6-category memory system
model LearnerProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  
  // Category 1: Skills & Competencies
  skills          Json?    // { skill: string, level: 0-100, lastValidated: date }[]
  
  // Category 2: Learning History
  learningHistory Json?    // { courseId, started, completed, certificateId }[]
  
  // Category 3: Preferences
  preferences     Json?    // { pace: string, modality: string[], language: string }
  
  // Category 4: Goals
  goals           Json?    // { goal: string, targetDate, priority }[]
  
  // Category 5: Engagement Patterns
  engagement      Json?    // { peakHours: string[], avgSessionMin: number, streakDays: number }
  
  // Category 6: Performance Analytics
  performance     Json?    // { quizAvg: number, strongestTopic: string, weakestTopic: string }
  
  // Tone preference (SAGE Tone Engine)
  preferredTone   String   @default("encouraging")  // encouraging, direct, formal, casual, socratic, motivational
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@map("learner_profiles")
}
