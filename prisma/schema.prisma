generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                            String                         @id @default(cuid())
  name                          String
  plan                          Plan                           @default(FREE)
  createdAt                     DateTime                       @default(now())
  updatedAt                     DateTime                       @updatedAt
  deletedAt                     DateTime?
  timezone                      String                         @default("UTC")
  currency                      String                         @default("USD")
  fiscalMonth                   Int                            @default(1)
  stripeCustomerId              String?
  stripeSubscriptionId          String?
  whiteLabelEnabled             Boolean                        @default(false)
  customDomain                  String?
  brandColor                    String?
  logoUrl                       String?
  faviconUrl                    String?
  agenticLoopProgresses         AgenticLoopProgress[]
  aiAgents                      AIAgent[]
  analyticsEvents               AnalyticsEvent[]
  apiKeys                       ApiKey[]
  assignments                   Assignment[]
  assistantActions              AssistantAction[]
  automations                   Automation[]
  breakoutRooms                 BreakoutRoom[]
  broadcastStreams              BroadcastStream[]
  cartItems                     CartItem[]
  carts                         Cart[]
  certificates                  Certificate[]
  communityChallengeSubmissions CommunityChallengeSubmission[]
  communityChallengeWinners     CommunityChallengeWinner[]
  comments                      Comment[]
  communityChallenges           CommunityChallenge[]
  communityInsights             CommunityInsight[]
  connectorInstalls             ConnectorInstall[]
  contractMilestones            ContractMilestone[]
  contracts                     Contract[]
  conversationParticipants      ConversationParticipant[]
  conversations                 Conversation[]
  corporateAccount              CorporateAccount?
  corporateEnrolls              CorporateEnroll[]
  courses                       Course[]
  creatorSubscriptions          CreatorSubscription[]
  creatorTiers                  CreatorTier[]
  dnsZones                      DNSZone[]
  enrollments                   Enrollment[]
  escrowPayments                EscrowPayment[]
  externalCourseEnrollments     ExternalCourseEnrollment[]
  externalCourseSaves           ExternalCourseSave[]
  flashcardReviews              FlashcardReview[]
  flashcards                    Flashcard[]
  follows                       Follow[]
  freelancerProfiles            FreelancerProfile[]
  groupLearningTracks           GroupLearningTrack[]
  groupMembers                  GroupMember[]
  groups                        Group[]
  invites                       Invite[]
  jobApplications               JobApplication[]
  jobListings                   JobListing[]
  knowledgeGraphEdges           KnowledgeGraphEdge[]
  knowledgeGraphNodes           KnowledgeGraphNode[]
  learnerNotes                  LearnerNote[]
  learnerProfiles               LearnerProfile[]
  learningPaths                 LearningPath[]
  learningStreaks               LearningStreak[]
  lectureUploads                LectureUpload[]
  lessonProgresses              LessonProgress[]
  lessons                       Lesson[]
  likes                         Like[]
  liveSessionAttendees          LiveSessionAttendee[]
  liveSessions                  LiveSession[]
  liveSpaces                    LiveSpace[]
  mentorSessions                MentorSession[]
  mentors                       Mentor[]
  messageReads                  MessageRead[]
  messages                      Message[]
  modules                       Module[]
  notifications                 Notification[]
  novaSkillDetections           NovaSkillDetection[]
  opportunities                 Opportunity[]
  orderItems                    OrderItem[]
  orderTrackings                OrderTracking[]
  orders                        Order[]
  pathCourses                   PathCourse[]
  pathEnrollments               PathEnrollment[]
  portfolioItems                PortfolioItem[]
  postReactions                 PostReaction[]
  posts                         Post[]
  ppvaccesses                   PPVAccess[]
  privacyAcknowledgments        PrivacyAcknowledgment[]
  productImages                 ProductImage[]
  productReviews                ProductReview[]
  productVariants               ProductVariant[]
  products                      Product[]
  qaquestions                   QAQuestion[]
  quizAttempts                  QuizAttempt[]
  quizQuestions                 QuizQuestion[]
  quizzes                       Quiz[]
  quotePosts                    QuotePost[]
  referralCredits               ReferralCredit[]
  revenueRecords                RevenueRecord[]
  reviews                       Review[]
  savedPosts                    SavedPost[]
  sessionTranscripts            SessionTranscript[]
  siteDeploys                   SiteDeploy[]
  skillEndorsements             SkillEndorsement[]
  socialAccounts                SocialAccount[]
  socialCrossPosts              SocialCrossPost[]
  socialMetricSnapshots         SocialMetricSnapshot[]
  socialScheduledPosts          SocialScheduledPost[]
  socialSkillSignals            SocialSkillSignal[]
  streamViewers                 StreamViewer[]
  studioEvents                  StudioEvent[]
  studioRsvps                   StudioRsvp[]
  studyGroups                   StudyGroup[]
  studyMembers                  StudyMember[]
  submissions                   Submission[]
  superChats                    SuperChat[]
  usageLogs                     UsageLog[]
  userFeedPreferences           UserFeedPreference[]
  users                         User[]
  vendorPayouts                 VendorPayout[]
  vendorReviews                 VendorReview[]
  vendors                       Vendor[]
  userWallets                   UserWallet[]
  withdrawalRequests            WithdrawalRequest[]
  videoRoomParticipants         VideoRoomParticipant[]
  videoRooms                    VideoRoom[]
  webhookSubscriptions          WebhookSubscription[]
  workReviews                   WorkReview[]

  @@map("tenants")
}

model User {
  id                         String                         @id @default(cuid())
  tenantId                   String
  email                      String
  name                       String
  password                   String
  role                       Role                           @default(MEMBER)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt
  deletedAt                  DateTime?
  twoFactorSecret            String?
  twoFactorEnabled           Boolean                        @default(false)
  twoFactorMethod            String?
  twoFactorBackup            String[]                       @default([])
  country                    String?
  city                       String?
  bio                        String?
  skills                     String[]
  industry                   String?
  isPublicProfile            Boolean                        @default(true)
  profileViews               Int                            @default(0)
  metadata                   Json                           @default("{}")
  profileType                String?
  onboardingDone             Boolean                        @default(false)
  omegaMission               String?                        @db.Text
  incomeGoal                 String?
  experienceLevel            String?
  primaryMarkets             String[]                       @default([])
  primarySkills              String[]                       @default([])
  teamType                   String?
  onboardingData             Json?
  firstPlatform              String?
  trustScore                 Int                            @default(50)
  trustScoreTier             String                         @default("SILVER")
  trustScoreUpdatedAt        DateTime?
  openToOpportunities        Boolean                        @default(false)
  opportunityStatus          String?
  opportunityBio             String?
  hostedBroadcasts           BroadcastStream[]
  carts                      Cart[]
  courseCertificates         Certificate[]                  @relation("CourseCertificate")
  challengeSubmissions       CommunityChallengeSubmission[]
  challengeWins              CommunityChallengeWinner[]
  comments                   Comment[]                      @relation("CommentAuthor")
  clientContracts            Contract[]                     @relation("ClientContracts")
  conversationParticipations ConversationParticipant[]
  createdConversations       Conversation[]                 @relation("ConversationCreator")
  corporateEnrolls           CorporateEnroll[]
  instructedCourses          Course[]                       @relation("CourseInstructor")
  creatorSubscriptions       CreatorSubscription[]          @relation("Creator")
  subscriberSubscriptions    CreatorSubscription[]          @relation("Subscriber")
  creatorTier                CreatorTier[]
  deviceTokens               DeviceToken[]
  courseEnrollments          Enrollment[]                   @relation("CourseEnrollment")
  flashcardReviews           FlashcardReview[]
  flashcards                 Flashcard[]
  followers                  Follow[]                       @relation("Followers")
  following                  Follow[]                       @relation("Following")
  freelancerProfile          FreelancerProfile?
  learningTracks             GroupLearningTrack[]           @relation("LearningTrackCreator")
  groupMemberships           GroupMember[]
  createdGroups              Group[]                        @relation("GroupCreator")
  postedJobs                 JobListing[]
  learnerNotes               LearnerNote[]
  learnerProfile             LearnerProfile?
  learningStreak             LearningStreak?
  lectureUploads             LectureUpload[]
  lessonProgress             LessonProgress[]               @relation("LessonProgress")
  likes                      Like[]
  attendedSessions           LiveSessionAttendee[]
  hostedLiveSessions         LiveSession[]
  spaceParticipations        LiveSpaceParticipant[]
  spaceSpeakers              LiveSpaceSpeaker[]
  hostedSpaces               LiveSpace[]                    @relation("LiveSpaceHost")
  mentorSessions             MentorSession[]                @relation("MentorSessionLearner")
  mentorProfile              Mentor?
  messageReads               MessageRead[]
  messages                   Message[]                      @relation("MessageSender")
  novaSkills                 NovaSkillDetection[]           @relation("UserNovaSkills")
  opportunities              Opportunity[]
  orders                     Order[]
  passwordResetTokens        PasswordResetToken[]
  pathEnrollments            PathEnrollment[]
  postReactions              PostReaction[]
  posts                      Post[]                         @relation("PostAuthor")
  ppvPurchases               PPVAccess[]
  privacyAcknowledgment      PrivacyAcknowledgment?
  productReviews             ProductReview[]
  qaQuestions                QAQuestion[]
  referralCredits            ReferralCredit[]
  referralsReceived          Referral[]                     @relation("ReferredRelation")
  referralsGiven             Referral[]                     @relation("ReferrerRelation")
  courseReviews              Review[]                       @relation("CourseReview")
  savedPosts                 SavedPost[]
  givenEndorsements          SkillEndorsement[]             @relation("Endorser")
  endorsedSkills             SkillEndorsement[]             @relation("Endorsee")
  socialAccounts             SocialAccount[]
  socialCrossPosts           SocialCrossPost[]
  socialMetricSnapshots      SocialMetricSnapshot[]
  socialScheduledPosts       SocialScheduledPost[]
  socialSkillSignals         SocialSkillSignal[]
  streamViewers              StreamViewer[]
  studioEvents               StudioEvent[]
  studioRsvps                StudioRsvp[]
  studyGroups                StudyGroup[]
  studyMembers               StudyMember[]
  submissions                Submission[]
  superChats                 SuperChat[]
  twoFactorOTPs              TwoFactorOTP[]
  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  vendorReviews              VendorReview[]
  vendors                    Vendor[]
  userWallets                UserWallet[]
  withdrawalRequests         WithdrawalRequest[]
  videoRoomParticipations    VideoRoomParticipant[]
  hostedVideoRooms           VideoRoom[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model PrivacyAcknowledgment {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String   @unique
  policyVersion  String
  acknowledgedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([acknowledgedAt(sort: Desc)])
  @@map("privacy_acknowledgments")
}

model TwoFactorOTP {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("two_factor_otps")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Invite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      Role     @default(MEMBER)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("invites")
}

model RevenueRecord {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Float
  currency    String   @default("USD")
  source      String
  description String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recordedAt])
  @@map("revenue_records")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  event     String   @default("unknown")
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([event])
  @@index([createdAt])
  @@map("analytics_events")
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referredId    String?
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  creditAwarded Boolean        @default(false)
  createdAt     DateTime       @default(now())
  convertedAt   DateTime?
  referred      User?          @relation("ReferredRelation", fields: [referredId], references: [id])
  referrer      User           @relation("ReferrerRelation", fields: [referrerId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

model ReferralCredit {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  amount    Float
  reason    String?
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("referral_credits")
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  userEmail String?
  userName  String?
  action    String
  category  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ChangelogType @default(FEATURE)
  version     String?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  published   Boolean       @default(true)

  @@index([publishedAt(sort: Desc)])
  @@map("changelog_entries")
}

model Post {
  id              String               @id @default(cuid())
  tenantId        String
  authorId        String
  content         String
  mediaUrl        String?
  mediaType       String?
  linkUrl         String?
  linkTitle       String?
  edited          Boolean              @default(false)
  isPinned        Boolean              @default(false)
  engagementScore Int                  @default(0)
  quotedPostId    String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?
  groupId         String?
  comments        Comment[]
  likes           Like[]
  novaSkills      NovaSkillDetection[]
  reactions       PostReaction[]
  tags            PostTag[]
  author          User                 @relation("PostAuthor", fields: [authorId], references: [id])
  group           Group?               @relation("GroupPosts", fields: [groupId], references: [id])
  quotedPost      Post?                @relation("SelfQuotedPost", fields: [quotedPostId], references: [id])
  quotedByPosts   Post[]               @relation("SelfQuotedPost")
  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  quotingPosts    QuotePost[]          @relation("QuotingPost")
  quotedInPosts   QuotePost[]          @relation("QuotedPost")
  savedPosts      SavedPost[]

  @@unique([id, tenantId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([tenantId, isPinned])
  @@index([groupId])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  tenantId  String
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  author    User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  likes     Like[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post      Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, postId, tenantId])
  @@unique([userId, commentId, tenantId])
  @@index([tenantId])
  @@index([postId])
  @@index([commentId])
  @@map("likes")
}

model PostReaction {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String
  reaction  String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, reaction, tenantId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([postId])
  @@index([reaction])
  @@map("post_reactions")
}

model Follow {
  id          String   @id @default(cuid())
  tenantId    String
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([followerId, followingId, tenantId])
  @@index([tenantId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Group {
  id             String               @id @default(cuid())
  tenantId       String
  name           String
  slug           String
  description    String?
  coverImage     String?
  isPrivate      Boolean              @default(false)
  createdById    String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  learningTracks GroupLearningTrack[]
  members        GroupMember[]
  createdBy      User                 @relation("GroupCreator", fields: [createdById], references: [id])
  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  posts          Post[]               @relation("GroupPosts")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(cuid())
  tenantId String
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())
  group    Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([groupId, userId, tenantId])
  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

model GroupLearningTrack {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String
  title        String
  description  String?
  currentWeek  Int      @default(1)
  totalWeeks   Int      @default(4)
  startDate    DateTime
  endDate      DateTime
  courseId     String?
  participants Int      @default(0)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creator      User     @relation("LearningTrackCreator", fields: [createdById], references: [id])
  group        Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([groupId])
  @@index([createdById])
  @@map("group_learning_tracks")
}

model LiveSpace {
  id           String                 @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  hostId       String
  status       LiveSpaceStatus        @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  maxSpeakers  Int                    @default(6)
  maxListeners Int                    @default(500)
  isRecorded   Boolean                @default(false)
  recordingUrl String?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  participants LiveSpaceParticipant[]
  speakers     LiveSpaceSpeaker[]
  host         User                   @relation("LiveSpaceHost", fields: [hostId], references: [id])
  tenant       Tenant                 @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([hostId])
  @@index([status])
  @@map("live_spaces")
}

model LiveSpaceParticipant {
  id       String                   @id @default(cuid())
  spaceId  String
  userId   String
  role     LiveSpaceParticipantRole @default(LISTENER)
  joinedAt DateTime                 @default(now())
  leftAt   DateTime?
  space    LiveSpace                @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@index([userId])
  @@map("live_space_participants")
}

model LiveSpaceSpeaker {
  id        String    @id @default(cuid())
  spaceId   String
  userId    String
  isMuted   Boolean   @default(false)
  isInvited Boolean   @default(false)
  joinedAt  DateTime  @default(now())
  space     LiveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@map("live_space_speakers")
}

model Opportunity {
  id          String            @id @default(cuid())
  tenantId    String
  userId      String
  title       String
  description String
  type        OpportunityType
  category    String
  budget      String?
  skills      String[]
  location    String?
  status      OpportunityStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  expiresAt   DateTime?
  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@map("opportunities")
}

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String
  actorId    String?
  type       NotificationType
  title      String
  body       String
  entityId   String?
  entityType String?
  link       String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  tenant     Tenant           @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([userId, read])
  @@index([tenantId])
  @@map("notifications")
}

model CreatorSubscription {
  id           String             @id @default(cuid())
  tenantId     String
  subscriberId String
  creatorId    String
  tier         String
  amount       Int
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  expiresAt    DateTime?
  stripeSubId  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  creator      User               @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  subscriber   User               @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  tenant       Tenant             @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([subscriberId, creatorId])
  @@index([tenantId])
  @@index([creatorId])
  @@index([subscriberId])
  @@map("creator_subscriptions")
}

model CreatorTier {
  id           String   @id @default(cuid())
  creatorId    String
  tenantId     String
  name         String
  description  String?
  benefits     String[]
  monthlyPrice Int
  yearlyPrice  Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([creatorId, name])
  @@index([tenantId])
  @@map("creator_tiers")
}

model CommunityChallenge {
  id          String                         @id @default(cuid())
  tenantId    String
  title       String
  description String
  category    String
