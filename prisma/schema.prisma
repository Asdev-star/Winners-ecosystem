// prisma/schema.prisma
// Winners Ecosystem — Complete Schema
// Phase 1: Core Engine + Phase 2: Community Layer V1.2 (Groups)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE ENGINE — PHASE 1
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                   String    @id @default(cuid())
  name                 String
  plan                 Plan      @default(FREE)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  timezone             String    @default("UTC")
  currency             String    @default("USD")
  fiscalMonth          Int       @default(1)
  stripeCustomerId     String?
  stripeSubscriptionId String?

  users                  User[]
  invites                Invite[]
  revenueRecords         RevenueRecord[]
  analyticsEvents        AnalyticsEvent[]
  referralCredits        ReferralCredit[]
  posts                  Post[]
  groups                 Group[]
  privacyAcknowledgments PrivacyAcknowledgment[]
  courses                Course[]
  conversations          Conversation[]
  liveSpaces             LiveSpace[]
  videoRooms            VideoRoom[]
  broadcastStreams      BroadcastStream[]
  studioEvents          StudioEvent[]
  corporateAccount     CorporateAccount?
  // Market relations
  vendors               Vendor[]
  products              Product[]
  carts                 Cart[]
  orders                Order[]
  // Work relations
  jobListings           JobListing[]
  freelancerProfiles    FreelancerProfile[]

  @@map("tenants")
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model User {
  id               String    @id @default(cuid())
  tenantId         String
  email            String
  name             String
  password         String
  role             Role      @default(MEMBER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  twoFactorMethod  String?
  twoFactorBackup  String[]  @default([])

  tenant                     Tenant                         @relation(fields: [tenantId], references: [id])
  passwordResetTokens        PasswordResetToken[]
  referralsGiven             Referral[]                     @relation("ReferrerRelation")
  referralsReceived          Referral[]                     @relation("ReferredRelation")
  referralCredits            ReferralCredit[]
  twoFactorOTPs              TwoFactorOTP[]
  posts                      Post[]                         @relation("PostAuthor")
  comments                   Comment[]                      @relation("CommentAuthor")
  likes                      Like[]
  followers                  Follow[]                       @relation("Followers")
  following                  Follow[]                       @relation("Following")
  createdGroups              Group[]                        @relation("GroupCreator")
  groupMemberships           GroupMember[]
  privacyAcknowledgment      PrivacyAcknowledgment?
  instructedCourses          Course[]                       @relation("CourseInstructor")
  courseEnrollments          Enrollment[]                   @relation("CourseEnrollment")
  lessonProgress             LessonProgress[]               @relation("LessonProgress")
  courseCertificates         Certificate[]                  @relation("CourseCertificate")
  courseReviews              Review[]                       @relation("CourseReview")
  createdConversations       Conversation[]                 @relation("ConversationCreator")
  messages                   Message[]                      @relation("MessageSender")
  conversationParticipations ConversationParticipant[]
  messageReads               MessageRead[]
  hostedSpaces               LiveSpace[]                    @relation("LiveSpaceHost")
  spaceParticipations        LiveSpaceParticipant[]
  spaceSpeakers              LiveSpaceSpeaker[]
  opportunities              Opportunity[]
  subscriberSubscriptions    CreatorSubscription[]          @relation("Subscriber")
  creatorSubscriptions       CreatorSubscription[]          @relation("Creator")
  creatorTier                CreatorTier[]
  challengeSubmissions       CommunityChallengeSubmission[]
  challengeWins              CommunityChallengeWinner[]
  savedPosts                 SavedPost[]
  endorsedSkills             SkillEndorsement[]             @relation("Endorsee")
  givenEndorsements          SkillEndorsement[]             @relation("Endorser")
  learningTracks             GroupLearningTrack[]           @relation("LearningTrackCreator")
  novaSkills                 NovaSkillDetection[]           @relation("UserNovaSkills")
  postReactions              PostReaction[]

  // Social Media Integrations
  socialAccounts        SocialAccount[]
  socialCrossPosts       SocialCrossPost[]
  socialMetricSnapshots SocialMetricSnapshot[]
  socialSkillSignals    SocialSkillSignal[]
  socialScheduledPosts  SocialScheduledPost[]

  // Community Studio - Video Rooms & Broadcasts
  hostedVideoRooms     VideoRoom[]
  videoRoomParticipations VideoRoomParticipant[]
  hostedBroadcasts    BroadcastStream[]
  streamViewers       StreamViewer[]
  superChats          SuperChat[]
  ppvPurchases       PPVAccess[]
  studioEvents        StudioEvent[]
  studioRsvps         StudioRsvp[]
  qaQuestions        QAQuestion[]

  // SAGE Super-Intelligence V2 Relations
  flashcards         Flashcard[]
  flashcardReviews   FlashcardReview[]
  mentorProfile      Mentor?
  mentorSessions     MentorSession[]       @relation("MentorSessionLearner")
  hostedLiveSessions LiveSession[]
  attendedSessions   LiveSessionAttendee[]
  learnerProfile     LearnerProfile?
  learningStreak     LearningStreak?
  lectureUploads     LectureUpload[]
  pathEnrollments    PathEnrollment[]
  studyGroups        StudyGroup[]
  submissions        Submission[]
  learnerNotes       LearnerNote[]

  // Diaspora Directory fields
  country         String?
  city            String?
  bio             String?
  skills          String[] // Array of skills for directory
  industry        String?
  isPublicProfile Boolean  @default(true)
  profileViews    Int      @default(0)
  metadata        Json     @default("{}")

  // Trust Score system (0-100)
  trustScore          Int       @default(50)
  trustScoreTier      String    @default("SILVER") // BRONZE, SILVER, GOLD, PLATINUM
  trustScoreUpdatedAt DateTime?

  // Open to Opportunities signal (V2 feature)
  openToOpportunities Boolean           @default(false)
  opportunityStatus   String? // LOOKING_FOR_WORK, OPEN_TO_COLLAB, HIRING
  opportunityBio      String? // Brief description of what user is open to
  studyMembers        StudyMember[]
  corporateEnrolls    CorporateEnroll[]

  // Work - Freelance Marketplace
  postedJobs           JobListing[]
  clientContracts     Contract[]                   @relation("ClientContracts")
  freelancerProfile   FreelancerProfile?

  // Market relations
  vendors             Vendor[]
  carts              Cart[]
  orders             Order[]
  productReviews     ProductReview[]
  vendorReviews      VendorReview[]

  @@unique([email, tenantId])
  @@index([tenantId])
  @@map("users")
}

model PrivacyAcknowledgment {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String   @unique
  policyVersion  String
  acknowledgedAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([acknowledgedAt(sort: Desc)])
  @@map("privacy_acknowledgments")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model TwoFactorOTP {
  id        String   @id @default(cuid())
  userId    String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("two_factor_otps")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique @default(cuid())
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model Invite {
  id        String   @id @default(cuid())
  tenantId  String
  email     String
  role      Role     @default(MEMBER)
  token     String   @unique @default(cuid())
  expiresAt DateTime
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([token])
  @@map("invites")
}

model RevenueRecord {
  id          String   @id @default(cuid())
  tenantId    String
  amount      Float
  currency    String   @default("USD")
  source      String
  description String?
  recordedAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([recordedAt])
  @@map("revenue_records")
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  tenantId  String
  event     String   @default("unknown")
  userId    String?
  metadata  Json?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([event])
  @@index([createdAt])
  @@map("analytics_events")
}

model Referral {
  id            String         @id @default(cuid())
  referrerId    String
  referredId    String?
  code          String         @unique
  status        ReferralStatus @default(PENDING)
  creditAwarded Boolean        @default(false)
  createdAt     DateTime       @default(now())
  convertedAt   DateTime?

  referrer User  @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referred User? @relation("ReferredRelation", fields: [referredId], references: [id])

  @@index([referrerId])
  @@index([code])
  @@map("referrals")
}

enum ReferralStatus {
  PENDING
  CONVERTED
  EXPIRED
}

model ReferralCredit {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  amount    Float
  reason    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@map("referral_credits")
}

model ActivityLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  userEmail String?
  userName  String?
  action    String
  category  String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt(sort: Desc)])
  @@map("activity_logs")
}

model ChangelogEntry {
  id          String        @id @default(cuid())
  title       String
  description String
  type        ChangelogType @default(FEATURE)
  version     String?
  publishedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  published   Boolean       @default(true)

  @@index([publishedAt(sort: Desc)])
  @@map("changelog_entries")
}

enum ChangelogType {
  FEATURE
  BUGFIX
  IMPROVEMENT
  COMING_SOON
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.0
// ─────────────────────────────────────────────────────────────────────────────

model Post {
  id              String    @id @default(cuid())
  tenantId        String
  authorId        String
  content         String
  mediaUrl        String?
  mediaType       String?
  linkUrl         String?
  linkTitle       String?
  edited          Boolean   @default(false)
  isPinned        Boolean   @default(false)
  engagementScore Int       @default(0)
  quotedPostId    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  groupId         String?

  tenant        Tenant               @relation(fields: [tenantId], references: [id])
  author        User                 @relation("PostAuthor", fields: [authorId], references: [id])
  comments      Comment[]
  likes         Like[]
  reactions     PostReaction[]
  tags          PostTag[]
  group         Group?               @relation("GroupPosts", fields: [groupId], references: [id])
  savedPosts    SavedPost[]
  novaSkills    NovaSkillDetection[]
  quotedPost    Post?                @relation("SelfQuotedPost", fields: [quotedPostId], references: [id])
  quotedByPosts Post[]               @relation("SelfQuotedPost")
  quotingPosts  QuotePost[]          @relation("QuotingPost")
  quotedInPosts QuotePost[]          @relation("QuotedPost")

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([authorId])
  @@index([tenantId, isPinned])
  @@index([groupId])
  @@unique([id, tenantId])
  @@map("posts")
}

model Comment {
  id        String    @id @default(cuid())
  tenantId  String
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  post    Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User      @relation("CommentAuthor", fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  likes   Like[]

  @@index([tenantId])
  @@index([postId])
  @@index([authorId])
  @@index([parentId])
  @@unique([id, tenantId])
  @@map("comments")
}

model Like {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String?
  commentId String?
  createdAt DateTime @default(now())

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, postId, tenantId])
  @@unique([userId, commentId, tenantId])
  @@index([tenantId])
  @@index([postId])
  @@index([commentId])
  @@map("likes")
}

// Six-reaction system for community posts
model PostReaction {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String
  reaction  String // ❤️, 🔥, 💡, 👏, 😂, 😱
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId, reaction, tenantId])
  @@index([tenantId])
  @@index([postId])
  @@index([reaction])
  @@unique([id, tenantId])
  @@map("post_reactions")
}

model Follow {
  id          String   @id @default(cuid())
  tenantId    String
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  follower  User   @relation("Followers", fields: [followerId], references: [id], onDelete: Cascade)
  following User   @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([followerId, followingId, tenantId])
  @@index([tenantId])
  @@index([followerId])
  @@index([followingId])
  @@map("follows")
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.2: GROUPS
// ─────────────────────────────────────────────────────────────────────────────

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  slug        String
  description String?
  coverImage  String?
  isPrivate   Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant               @relation(fields: [tenantId], references: [id])
  createdBy      User                 @relation("GroupCreator", fields: [createdById], references: [id])
  members        GroupMember[]
  posts          Post[]               @relation("GroupPosts")
  learningTracks GroupLearningTrack[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("groups")
}

model GroupMember {
  id       String          @id @default(cuid())
  tenantId String
  groupId  String
  userId   String
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([groupId, userId, tenantId])
  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
  @@map("group_members")
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

// Group Learning Tracks (Facebook Events adapted for professional development)
model GroupLearningTrack {
  id           String   @id @default(cuid())
  tenantId     String
  groupId      String
  title        String
  description  String?
  currentWeek  Int      @default(1)
  totalWeeks   Int      @default(4)
  startDate    DateTime
  endDate      DateTime
  courseId     String? // optional link to Academy course
  participants Int      @default(0)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  creator User  @relation("LearningTrackCreator", fields: [createdById], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([groupId])
  @@index([createdById])
  @@map("group_learning_tracks")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.4: LIVE SPACES
// ─────────────────────────────────────────────────────────────────────────────

model LiveSpace {
  id           String          @id @default(cuid())
  tenantId     String
  title        String
  description  String?
  hostId       String
  status       LiveSpaceStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  startedAt    DateTime?
  endedAt      DateTime?
  maxSpeakers  Int             @default(6)
  maxListeners Int             @default(500)
  isRecorded   Boolean         @default(false)
  recordingUrl String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tenant       Tenant                 @relation(fields: [tenantId], references: [id])
  host         User                   @relation("LiveSpaceHost", fields: [hostId], references: [id])
  participants LiveSpaceParticipant[]
  speakers     LiveSpaceSpeaker[]

  @@index([tenantId])
  @@index([hostId])
  @@index([status])
  @@map("live_spaces")
}

model LiveSpaceParticipant {
  id       String                   @id @default(cuid())
  spaceId  String
  userId   String
  role     LiveSpaceParticipantRole @default(LISTENER)
  joinedAt DateTime                 @default(now())
  leftAt   DateTime?

  space LiveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@index([userId])
  @@map("live_space_participants")
}

model LiveSpaceSpeaker {
  id        String   @id @default(cuid())
  spaceId   String
  userId    String
  isMuted   Boolean  @default(false)
  isInvited Boolean  @default(false)
  joinedAt  DateTime @default(now())

  space LiveSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([spaceId])
  @@map("live_space_speakers")
}

// ─── Opportunity Board ───────────────────────────────────────────────────────────

model Opportunity {
  id       String @id @default(cuid())
  tenantId String
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title       String
  description String            @db.Text
  type        OpportunityType
  category    String // "job", "collab", "mentorship", "investment"
  budget      String? // e.g., "$5000", "negotiable", "volunteer"
  skills      String[]
  location    String? // remote, specific country/city
  status      OpportunityStatus @default(ACTIVE)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([type])
  @@index([category])
  @@map("opportunities")
}

// ─── Community Notifications ──────────────────────────────────────────────────────

model Notification {
  id         String           @id @default(cuid())
  tenantId   String
  userId     String // recipient
  actorId    String? // who triggered it
  type       NotificationType // like | comment | follow | mention | skill_detected
  title      String
  body       String
  entityId   String? // postId, commentId, etc.
  entityType String? // post | comment | group | opportunity
  link       String? // navigation link
  read       Boolean          @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([userId, read])
  @@index([tenantId])
  @@map("notifications")
}

enum NotificationType {
  LIKE
  COMMENT
  FOLLOW
  MENTION
  SKILL_DETECTED
  OPPORTUNITY_MATCH
  TRUST_SCORE_UPDATE
  CHALLENGE_COMPLETE
  LOOP_ADVANCE
  SYSTEM
}

enum OpportunityType {
  JOB
  COLLABORATION
  MENTORSHIP
  INVESTMENT
}

enum OpportunityStatus {
  ACTIVE
  FILLED
  EXPIRED
  ARCHIVED
}

// ─── Creator Subscriptions ─────────────────────────────────────────────────────────

model CreatorSubscription {
  id           String             @id @default(cuid())
  tenantId     String
  subscriberId String
  creatorId    String
  subscriber   User               @relation("Subscriber", fields: [subscriberId], references: [id], onDelete: Cascade)
  creator      User               @relation("Creator", fields: [creatorId], references: [id], onDelete: Cascade)
  tier         String // "basic", "pro", "premium"
  amount       Int // amount in cents
  status       SubscriptionStatus @default(ACTIVE)
  startedAt    DateTime           @default(now())
  expiresAt    DateTime?
  stripeSubId  String? // Stripe subscription ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([subscriberId, creatorId])
  @@index([tenantId])
  @@index([creatorId])
  @@index([subscriberId])
  @@map("creator_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAUSED
}

model CreatorTier {
  id           String   @id @default(cuid())
  creatorId    String
  tenantId     String
  creator      User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  benefits     String[] // benefits for this tier
  monthlyPrice Int // monthly price in cents
  yearlyPrice  Int // yearly price in cents
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([creatorId, name])
  @@index([tenantId])
  @@map("creator_tiers")
}

// ─── Community Challenges ───────────────────────────────────────────────────────────

model CommunityChallenge {
  id          String          @id @default(cuid())
  tenantId    String
  title       String
  description String
  category    String // "content", "engagement", "creation", "growth"
  prize       String // "credits", "badge", "featured", "subscription"
  prizeValue  Int // amount of credits or badge name
  startsAt    DateTime
  endsAt      DateTime
  status      ChallengeStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant                         @relation(fields: [tenantId], references: [id])
  submissions CommunityChallengeSubmission[]
  winners     CommunityChallengeWinner[]

  @@unique([id, tenantId])
  @@index([tenantId, status])
  @@index([endsAt])
  @@map("community_challenges")
}

model CommunityChallengeSubmission {
  id          String  @id @default(cuid())
  tenantId    String
  challengeId String
  userId      String
  postId      String?
  content     String  @db.Text
  engagement  Int     @default(0) // likes + comments + shares

  createdAt DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([challengeId, userId])
  @@index([tenantId])
  @@index([challengeId, engagement(sort: Desc)])
  @@map("challenge_submissions")
}

model CommunityChallengeWinner {
  id           String @id @default(cuid())
  tenantId     String
  challengeId  String
  userId       String
  rank         Int // 1st, 2nd, 3rd
  prizeAwarded String

  createdAt DateTime @default(now())

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([challengeId, rank])
  @@index([tenantId])
  @@map("challenge_winners")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V2.0: INTELLIGENT UPGRADE
// Skills Endorsement, NOVA Detection, Community Insights
// ─────────────────────────────────────────────────────────────────────────────

// Skills Endorsement System (LinkedIn-inspired)
model SkillEndorsement {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String // User being endorsed
  endorserId String // User giving endorsement
  skill      String
  weight     Float    @default(1.0) // Weight based on endorser's trust score
  createdAt  DateTime @default(now())

  tenant   Tenant @relation(fields: [tenantId], references: [id])
  endorsee User   @relation("Endorsee", fields: [userId], references: [id], onDelete: Cascade)
  endorser User   @relation("Endorser", fields: [endorserId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([endorserId, userId, skill])
  @@index([tenantId])
  @@index([userId, skill])
  @@index([endorserId])
  @@map("skill_endorsements")
}

// NOVA Skill Detection Results
model NovaSkillDetection {
  id         String   @id @default(cuid())
  tenantId   String
  postId     String
  userId     String
  skill      String
  confidence Float // 0-100
  category   String? // 'technical', 'creative', 'business', 'soft', 'language'
  source     String   @default("post") // 'post', 'comment', 'voice', 'bio'
  loopStage  String? // 'skill', 'course', 'income'
  isActioned Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation("UserNovaSkills", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, postId, skill])
  @@index([tenantId])
  @@index([postId])
  @@index([skill])
  @@index([userId])
  @@map("nova_skill_detections")
}

// Community Insights (NOVA's intelligence)
model CommunityInsight {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  type      String // 'posting_momentum', 'skill_detected', 'opportunity_match', 'engagement_alert'
  title     String
  content   String   @db.Text
  metadata  Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId, isRead])
  @@index([type])
  @@index([createdAt(sort: Desc)])
  @@map("community_insights")
}

// Saved Posts (Bookmarks)
model SavedPost {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  postId    String
  isPublic  Boolean  @default(false) // Public bookmarks for social proof
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, postId])
  @@index([tenantId])
  @@index([userId])
  @@index([postId])
  @@map("saved_posts")
}

// Quote-Share (X-inspired) - when users share with commentary
model QuotePost {
  id           String   @id @default(cuid())
  tenantId     String
  postId       String // the quoting post
  quotedPostId String // the original post being quoted
  createdAt    DateTime @default(now())

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  post       Post   @relation("QuotingPost", fields: [postId], references: [id], onDelete: Cascade)
  quotedPost Post   @relation("QuotedPost", fields: [quotedPostId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([postId, quotedPostId])
  @@index([tenantId])
  @@index([postId])
  @@index([quotedPostId])
  @@map("quote_posts")
}

// User Feed Preferences
model UserFeedPreference {
  id               String   @id @default(cuid())
  tenantId         String
  userId           String   @unique
  feedMode         String   @default("foryou") // 'foryou', 'following', 'intelligence'
  novaIntelligence Boolean  @default(true)
  quickPostEnabled Boolean  @default(true)
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("user_feed_preferences")
}

// Agentic Loop Tracking per User
model AgenticLoopProgress {
  id             String    @id @default(cuid())
  tenantId       String
  userId         String
  stage          Int       @default(1) // 1-7
  stageName      String // 'skill_detection', 'learning', 'certification', 'work_match', 'contract', 'vendor', 'compound'
  currentStage   String? // 'community', 'academy', 'work', 'market', 'compound' - for display
  postsCount     Int       @default(0)
  skillsDetected Int       @default(0)
  coursesTaken   Int       @default(0)
  contractsWon   Int       @default(0)
  lastActivity   DateTime?
  updatedAt      DateTime  @updatedAt
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([userId])
  @@index([tenantId])
  @@index([userId])
  @@map("agentic_loop_progress")
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  VOTING
  COMPLETED
  CANCELLED
}

enum LiveSpaceStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

enum LiveSpaceParticipantRole {
  HOST
  SPEAKER
  LISTENER
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMUNITY LAYER — PHASE 2 V1.3: DIRECT MESSAGING
// ─────────────────────────────────────────────────────────────────────────────

model Conversation {
  id          String   @id @default(cuid())
  tenantId    String
  createdById String
  isGroup     Boolean  @default(false)
  title       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  createdBy    User                      @relation("ConversationCreator", fields: [createdById], references: [id])
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([id, tenantId])
  @@index([tenantId, updatedAt(sort: Desc)])
  @@index([createdById])
  @@map("conversations")
}

model ConversationParticipant {
  id             String           @id @default(cuid())
  tenantId       String
  conversationId String
  userId         String
  role           ConversationRole @default(MEMBER)
  lastReadAt     DateTime         @default(now())
  joinedAt       DateTime         @default(now())

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([conversationId, userId])
  @@index([tenantId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

enum ConversationRole {
  OWNER
  ADMIN
  MEMBER
}

model Message {
  id             String      @id @default(cuid())
  tenantId       String
  conversationId String
  senderId       String
  content        String
  type           MessageType @default(TEXT)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User          @relation("MessageSender", fields: [senderId], references: [id])
  reads        MessageRead[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  VOICE
  SYSTEM
}

model MessageRead {
  id        String   @id @default(cuid())
  tenantId  String
  messageId String
  userId    String
  readAt    DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([messageId, userId])
  @@index([tenantId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}

// PHASE 3 - WINNERS ACADEMY

model Course {
  id           String      @id @default(cuid())
  tenantId     String
  instructorId String
  title        String
  slug         String
  description  String
  about        String?
  thumbnail    String?
  previewVideo String?
  category     String
  level        CourseLevel @default(BEGINNER)
  price        Float       @default(0)
  currency     String      @default("USD")
  published    Boolean     @default(false)
  featured     Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  instructor   User          @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules      Module[]
  enrollments  Enrollment[]
  reviews      Review[]
  certificates Certificate[]

  // SAGE Super-Intelligence V2 Relations
  flashcards           Flashcard[]
  knowledgeGraph       KnowledgeGraphNode[]
  mentorSessions       MentorSession[]
  liveSessions         LiveSession[]
  lectureUploads       LectureUpload[]
  learningPaths        LearningPath[]
  pathCourses          PathCourse[]
  assignments          Assignment[]
  corporateEnrollments CorporateEnroll[]
  learnerNotes         LearnerNote[]
  studyGroups          StudyGroup[]

  @@unique([tenantId, slug])
  @@index([tenantId, published])
  @@index([instructorId])
  @@index([category])
  @@map("courses")
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Module {
  id          String   @id @default(cuid())
  tenantId    String
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  course Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([courseId, order])
  @@map("modules")
}

model Lesson {
  id          String   @id @default(cuid())
  tenantId    String
  moduleId    String
  title       String
  description String?
  content     String?
  videoUrl    String?
  duration    Int?
  order       Int      @default(0)
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  module      Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  assignments Assignment[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([moduleId, order])
  @@map("lessons")
}

model Enrollment {
  id              String           @id @default(cuid())
  tenantId        String
  courseId        String
  userId          String
  status          EnrollmentStatus @default(ACTIVE)
  paidAmount      Float            @default(0)
  stripePaymentId String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  course      Course           @relation(fields: [courseId], references: [id])
  user        User             @relation("CourseEnrollment", fields: [userId], references: [id])
  progress    LessonProgress[]
  certificate Certificate?

  @@unique([id, tenantId])
  @@unique([courseId, userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REFUNDED
  CANCELLED
}

model LessonProgress {
  id           String    @id @default(cuid())
  tenantId     String
  enrollmentId String
  lessonId     String
  userId       String
  completed    Boolean   @default(false)
  completedAt  DateTime?
  watchedSecs  Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user       User       @relation("LessonProgress", fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@unique([enrollmentId, lessonId])
  @@index([tenantId])
  @@index([userId])
  @@map("lesson_progress")
}

model Certificate {
  id           String   @id @default(cuid())
  tenantId     String
  enrollmentId String   @unique
  courseId     String
  userId       String
  verifyToken  String   @unique @default(cuid())
  issuedAt     DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id])
  course     Course     @relation(fields: [courseId], references: [id])
  user       User       @relation("CourseCertificate", fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@map("certificates")
}

// ─── External Course Integrations (Coursera, FreeCodeCamp, Udemy, etc.) ────────

model ExternalPlatform {
  id        String          @id // COURSERA, FREECODECAMP, etc.
  name      String
  icon      String?
  tenantId  String
  createdAt DateTime        @default(now())
}

// FreeCodeCamp sync for username-based import
model FreeCodeCampSync {
  id              String    @id @default(cuid())
  userId          String    @unique
  fccUsername     String
  lastSynced      DateTime  @default(now())
  certifications  Json      @default("[]") // [{name, completedDate, verificationUrl}]
  createdAt       DateTime  @default(now())
}

model ExternalCourse {
  id           String         @id @default(cuid())
  tenantId     String
  platform     String         // References ExternalPlatform.id
  platformName String?        // Denormalized for easier access
  externalId   String         // ID from external platform
  title        String
  description  String?
  thumbnailUrl String?
  courseUrl    String         // Link to external course
  affiliateUrl String?        // Affiliate link for revenue tracking
  instructor   String?
  institution  String?        // University or organization
  duration     Int?           // Duration in minutes
  category     String?
  subcategory  String?
  difficulty   String?        // Beginner, Intermediate, Advanced
  tags         String[]
  price        Float          @default(0) // 0 = free
  currency     String         @default("USD")
  rating       Float?
  reviewCount  Int            @default(0)
  enrollmentCount Int         @default(0)
  isVerified   Boolean        @default(false) // Verified by Winners team
  isFeatured   Boolean        @default(false)
  sageRecommended Boolean    @default(false)
  africanRelevance Int       @default(5) // 1-10 SAGE-scored relevance for African market
  workContractCount Int      @default(0) // CIRCUIT-populated: live job count for skills
  hasCertificate Boolean     @default(true)
  certificateType String?    // "Professional Certificate", "Specialization", etc.
  lastSynced   DateTime      @default(now())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  enrollments  ExternalCourseEnrollment[]
  saves        ExternalCourseSave[]

  @@unique([platform, externalId])
  @@index([tenantId])
  @@index([platform])
  @@index([category])
  @@index([isFeatured, sageRecommended])
  @@map("external_courses")
}

model ExternalCourseEnrollment {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  externalCourseId String
  enrolledAt      DateTime  @default(now())
  completedAt     DateTime?
  progress        Int       @default(0) // 0-100 percentage
  certificateUrl  String?   // URL to external certificate
  isSynced        Boolean   @default(false) // Synced with Winners certificate

  tenant         Tenant         @relation(fields: [tenantId], references: [id])
  externalCourse ExternalCourse @relation(fields: [externalCourseId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([userId, externalCourseId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("external_course_enrollments")
}

// User-saved external courses
model ExternalCourseSave {
  id         String         @id @default(cuid())
  tenantId   String
  userId     String
  courseId   String
  course     ExternalCourse @relation(fields:[courseId], references:[id])
  sageNote   String?        @db.Text // SAGE's note when it recommended this
  savedAt    DateTime       @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([userId, courseId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("external_course_saves")
}

model Review {
  id        String   @id @default(cuid())
  tenantId  String
  courseId  String
  userId    String
  rating    Int
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user   User   @relation("CourseReview", fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@unique([courseId, userId, tenantId])
  @@index([tenantId])
  @@index([courseId])
  @@map("reviews")
}

// ─── Quiz System ──────────────────────────────────────────────────────────────
model Quiz {
  id               String   @id @default(cuid())
  tenantId         String
  courseId         String
  moduleId         String?
  title            String
  description      String?
  passingScore     Int      @default(70) // percentage required to pass
  timeLimit        Int? // minutes, null = no limit
  shuffleQuestions Boolean  @default(false)
  showResults      Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String       @id @default(cuid())
  tenantId      String
  quizId        String
  question      String       @db.Text
  questionType  QuestionType @default(MULTIPLE_CHOICE)
  options       Json // array of option strings for MCQ
  correctAnswer String // for MCQ: option text, for TRUE_FALSE: "true"/"false"
  explanation   String?      @db.Text // shown after answer
  points        Int          @default(1)
  order         Int          @default(0)
  createdAt     DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "QuizQuestions")

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([quizId])
  @@map("quiz_questions")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model QuizAttempt {
  id            String    @id @default(cuid())
  tenantId      String
  quizId        String
  userId        String
  score         Int // raw score
  percentage    Float // percentage score
  passed        Boolean
  answers       Json // { questionId: selectedAnswer, isCorrect: boolean }[]
  timeTakenSecs Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade, map: "QuizAttempts")

  @@unique([id, tenantId])
  @@unique([quizId, userId], name: "quiz_user_attempt") // one attempt per user per quiz
  @@index([tenantId])
  @@index([userId])
  @@index([quizId])
  @@map("quiz_attempts")
}

// ─── SAGE Super-Intelligence V2 Models ────────────────────────────────────────
// REC 02: AI Flashcard Engine with Spaced Repetition
model Flashcard {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  courseId String?
  lessonId String?
  front    String   @db.Text // question/prompt
  back     String   @db.Text // answer
  tags     String[] // topic tags for organization

  // Spaced repetition fields (SM-2 algorithm)
  easeFactor  Float    @default(2.5) // SM-2 ease factor
  interval    Int      @default(0) // days until next review
  repetitions Int      @default(0) // successful reviews
  nextReview  DateTime @default(now()) // next scheduled review

  // Source tracking
  sourceType String? // "ai_generated", "user_created", "quiz_question"
  sourceId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id])
  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?           @relation(fields: [courseId], references: [id], onDelete: SetNull)
  reviews FlashcardReview[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@index([nextReview]) // for fetching due cards
  @@map("flashcards")
}

// REC 02: Flashcard Review History
model FlashcardReview {
  id          String   @id @default(cuid())
  tenantId    String
  flashcardId String
  userId      String
  quality     Int // 0-5 SM-2 quality rating
  reviewedAt  DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  flashcard Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([flashcardId])
  @@index([userId])
  @@map("flashcard_reviews")
}

// REC 01: Knowledge Graph - Course concept relationships
model KnowledgeGraphNode {
  id          String  @id @default(cuid())
  tenantId    String
  courseId    String
  concept     String // e.g., "React Hooks", "API Design"
  description String? @db.Text
  importance  Int     @default(1) // 1-5 node size
  xPos        Float? // for visualization
  yPos        Float?

  createdAt DateTime @default(now())

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  course   Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  outgoing KnowledgeGraphEdge[] @relation("EdgeFrom")
  incoming KnowledgeGraphEdge[] @relation("EdgeTo")

  @@unique([id, tenantId])
  @@unique([courseId, concept])
  @@index([tenantId])
  @@index([courseId])
  @@map("knowledge_graph_nodes")
}

model KnowledgeGraphEdge {
  id         String @id @default(cuid())
  tenantId   String
  fromNodeId String
  toNodeId   String
  relation   String // "prerequisites", "related", "builds_on", "example_of"
  weight     Float  @default(1.0)

  tenant   Tenant             @relation(fields: [tenantId], references: [id])
  fromNode KnowledgeGraphNode @relation("EdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode   KnowledgeGraphNode @relation("EdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([fromNodeId, toNodeId, relation])
  @@index([tenantId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("knowledge_graph_edges")
}

// REC 05: Mentor Network
model Mentor {
  id           String   @id @default(cuid())
  tenantId     String
  userId       String   @unique
  bio          String?  @db.Text
  expertise    String[] // skill areas
  availability String   @default("available") // available, limited, unavailable
  hourlyRate   Int? // cents
  timezone     String?
  linkedInUrl  String?

  // Stats
  sessionsCompleted Int   @default(0)
  avgRating         Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions MentorSession[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("mentors")
}

model MentorSession {
  id        String  @id @default(cuid())
  tenantId  String
  mentorId  String
  learnerId String
  courseId  String?

  scheduledAt DateTime
  durationMin Int      @default(60)
  status      String   @default("scheduled") // scheduled, completed, cancelled

  // Video/meeting
  meetingUrl String?

  // Feedback
  learnerFeedback String? @db.Text
  mentorRating    Int?

  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  mentor  Mentor  @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  learner User    @relation("MentorSessionLearner", fields: [learnerId], references: [id], onDelete: Cascade)
  course  Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([mentorId])
  @@index([learnerId])
  @@map("mentor_sessions")
}

// REC 06: Live Learning Sessions
model LiveSession {
  id          String  @id @default(cuid())
  tenantId    String
  courseId    String?
  hostId      String
  title       String
  description String? @db.Text

  scheduledAt DateTime
  durationMin Int      @default(60)
  status      String   @default("scheduled") // scheduled, live, ended, cancelled

  // Streaming
  streamUrl    String?
  recordingUrl String?

  // Capacity
  maxParticipants     Int @default(100)
  currentParticipants Int @default(0)

  // Type
  sessionType String @default("workshop") // workshop, qa, demo, cohort_call

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  host      User                  @relation(fields: [hostId], references: [id], onDelete: Cascade)
  course    Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  attendees LiveSessionAttendee[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([hostId])
  @@index([courseId])
  @@index([status])
  @@map("live_sessions")
}

model LiveSessionAttendee {
  id        String    @id @default(cuid())
  tenantId  String
  sessionId String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  tenant  Tenant      @relation(fields: [tenantId], references: [id])
  session LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([sessionId, userId])
  @@index([tenantId])
  @@index([sessionId])
  @@index([userId])
  @@map("live_session_attendees")
}

// SAGE Learner Profile - 6-category memory system
model LearnerProfile {
  id       String   @id @default(cuid())
  tenantId String
  userId   String   @unique

  // Category 1: Skills & Competencies
  skills Json? // { skill: string, level: 0-100, lastValidated: date }[]

  // Category 2: Learning History
  learningHistory Json? // { courseId, started, completed, certificateId }[]

  // Category 3: Preferences
  preferences Json? // { pace: string, modality: string[], language: string }

  // Category 4: Goals
  goals Json? // { goal: string, targetDate, priority }[]

  // Category 5: Engagement Patterns
  engagement Json? // { peakHours: string[], avgSessionMin: number, streakDays: number }

  // Category 6: Performance Analytics
  performance Json? // { quizAvg: number, strongestTopic: string, weakestTopic: string }

  // Tone preference (SAGE Tone Engine)
  preferredTone String @default("encouraging") // encouraging, direct, formal, casual, socratic, motivational

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("learner_profiles")
}

// ─── REC 10: Learning Streak System ───────────────────────────────────────────
model LearningStreak {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String    @unique
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDate DateTime?
  totalDaysLearned Int       @default(0)
  milestones       Json      @default("[]") // [{days, achievedAt, badge}]
  updatedAt        DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@map("learning_streaks")
}

// ─── REC 1: Lecture-to-Notes ───────────────────────────────────────────────
model LectureUpload {
  id            String   @id @default(cuid())
  tenantId      String
  userId        String
  courseId      String? // if linked to a specific course
  fileName      String
  fileUrl       String
  durationSecs  Int?
  status        String   @default("processing") // processing|complete|failed
  transcript    String?  @db.Text
  notes         String?  @db.Text // SAGE-generated structured notes
  glossary      Json? // [{term, definition}]
  quizQuestions Json? // generated quiz questions
  creditsCost   Int      @default(15)
  createdAt     DateTime @default(now())

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@map("lecture_uploads")
}

// ─── REC 7: Learning Paths ───────────────────────────────────────────────────
model LearningPath {
  id            String   @id @default(cuid())
  tenantId      String
  title         String
  description   String   @db.Text
  tagline       String
  category      String
  difficulty    String
  durationWeeks Int
  thumbnailUrl  String?
  certificate   String? // path certificate title
  price         Float    @default(0)
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  pathCourses PathCourse[]
  enrollments PathEnrollment[]
  course      Course?          @relation(fields: [courseId], references: [id])
  courseId    String?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("learning_paths")
}

model PathCourse {
  id         String       @id @default(cuid())
  tenantId   String
  pathId     String
  path       LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  orderIndex Int
  required   Boolean      @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([pathId, courseId])
  @@index([tenantId])
  @@index([pathId])
  @@index([courseId])
  @@map("path_courses")
}

model PathEnrollment {
  id              String       @id @default(cuid())
  tenantId        String
  pathId          String
  path            LearningPath @relation(fields: [pathId], references: [id], onDelete: Cascade)
  userId          String
  currentCourseId String? // courseId of current active course
  completedAt     DateTime?
  certificateId   String?
  createdAt       DateTime     @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([pathId, userId])
  @@index([tenantId])
  @@index([pathId])
  @@index([userId])
  @@map("path_enrollments")
}

// ─── REC 3: SAGE Study Groups ───────────────────────────────────────────────
model StudyGroup {
  id          String   @id @default(cuid())
  tenantId    String
  courseId    String
  creatorId   String
  name        String
  description String?  @db.Text
  maxMembers  Int      @default(8)
  sagePrompts Json     @default("[]") // weekly SAGE-generated prompts
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  course  Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  creator User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  members StudyMember[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([courseId])
  @@index([creatorId])
  @@map("study_groups")
}

model StudyMember {
  id       String     @id @default(cuid())
  tenantId String
  groupId  String
  group    StudyGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String     @default("member") // member|facilitator
  joinedAt DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
  @@map("study_members")
}

// ─── REC 5: Assignment Review Engine ─────────────────────────────────────────
model Assignment {
  id          String    @id @default(cuid())
  tenantId    String
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title       String
  description String    @db.Text
  type        String // code|design|essay|pdf|project
  rubric      Json // [{criterion, maxScore, description}]
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  submissions Submission[]
  course      Course?      @relation(fields: [courseId], references: [id])
  courseId    String?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([lessonId])
  @@map("assignments")
}

model Submission {
  id             String     @id @default(cuid())
  tenantId       String
  assignmentId   String
  assignment     Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content        String?    @db.Text // text submission
  fileUrl        String? // uploaded file
  sageFeedback   String?    @db.Text // SAGE's review
  sageScore      Int? // 0-100
  sageReviewedAt DateTime?
  submittedAt    DateTime   @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([assignmentId])
  @@index([userId])
  @@map("submissions")
}

// ─── REC 11: Corporate Learning Portal ──────────────────────────────────────
model CorporateAccount {
  id               String   @id @default(cuid())
  tenantId         String   @unique
  companyName      String
  seats            Int      @default(10)
  seatsUsed        Int      @default(0)
  plan             String   @default("standard") // standard|premium|enterprise
  stripeCustomerId String?
  createdAt        DateTime @default(now())

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments CorporateEnroll[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("corporate_accounts")
}

model CorporateEnroll {
  id          String           @id @default(cuid())
  tenantId    String
  corporateId String
  corporate   CorporateAccount @relation(fields: [corporateId], references: [id], onDelete: Cascade)
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  managerId   String // who enrolled this employee
  completedAt DateTime?
  createdAt   DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([corporateId])
  @@index([userId])
  @@index([courseId])
  @@map("corporate_enrollments")
}

// ─── REC 14: Learner Notebook ───────────────────────────────────────────────
model LearnerNote {
  id             String   @id @default(cuid())
  tenantId       String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId       String?
  lessonId       String?
  videoTimestamp Int? // seconds into video when note was taken
  content        String   @db.Text
  tags           Json     @default("[]")
  shared         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([courseId])
  @@map("learner_notes")
}

// ─── SOCIAL MEDIA INTEGRATIONS ──────────────────────────────────────────────
// NOVA-Powered Cross-Platform Intelligence for Community Layer

model SocialAccount {
  id           String   @id @default(cuid())
  userId       String
  tenantId     String
  platform     String   // facebook|instagram|whatsapp|telegram|twitter|messenger|linkedin|tiktok|youtube|threads|discord|pinterest|snapchat|substack|medium
  platformId   String
  username     String?
  displayName  String?
  profileImage String?
  accessToken  String?  @db.Text  // encrypted
  refreshToken String?  @db.Text  // encrypted
  tokenExpiry  DateTime?
  pageId       String?             // Facebook Page / Instagram Business account ID
  pageName     String?
  scopes       String[]  @default([])
  active       Boolean  @default(true)
  lastSynced   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  user     User                   @relation(fields:[userId], references:[id], onDelete: Cascade)
  posts    SocialCrossPost[]
  metrics  SocialMetricSnapshot[]
  skills   SocialSkillSignal[]
  scheduled SocialScheduledPost[]

  @@unique([id, tenantId])
  @@unique([userId, platform, platformId])
  @@index([tenantId])
  @@index([userId])
  @@index([platform])
  @@map("social_accounts")
}

model SocialCrossPost {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  communityPostId String?
  socialAccountId String
  platformPostId  String?
  status          String        @default("pending")  // pending|published|failed|skipped
  error           String?       @db.Text
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  user          User         @relation(fields:[userId], references:[id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields:[socialAccountId], references:[id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([communityPostId])
  @@index([socialAccountId, status])
  @@map("social_cross_posts")
}

model SocialMetricSnapshot {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  socialAccountId String
  platform        String
  snapshotDate    DateTime      @default(now())
  followers       Int           @default(0)
  followersGrowth Int           @default(0)
  reach           Int           @default(0)
  impressions     Int           @default(0)
  engagements     Int           @default(0)
  engagementRate  Float         @default(0)
  posts           Int           @default(0)
  topPostId       String?
  topPostReach    Int           @default(0)
  platformData    Json?         @default("{}")
  createdAt       DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  user          User         @relation(fields:[userId], references:[id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields:[socialAccountId], references:[id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([socialAccountId, snapshotDate])
  @@index([tenantId])
  @@index([userId])
  @@index([socialAccountId])
  @@index([snapshotDate])
  @@map("social_metric_snapshots")
}

model SocialSkillSignal {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  socialAccountId String?
  platform        String
  platformPostId  String?
  content         String        @db.Text  // post content that was analysed
  skill           String
  confidence      Float         @default(0)  // 0-1
  category        String?       // technical|creative|business|soft
  isActioned      Boolean       @default(false)  // has NOVA acted on this?
  loopFired       Boolean       @default(false)  // has this triggered Agentic Loop?
  createdAt       DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  user          User         @relation(fields:[userId], references:[id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields:[socialAccountId], references:[id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId, skill])
  @@index([platform])
  @@index([isActioned])
  @@map("social_skill_signals")
}

model SocialScheduledPost {
  id              String        @id @default(cuid())
  tenantId        String
  userId          String
  socialAccountId String?
  communityPostId String?
  content         String        @db.Text
  mediaUrls       String[]      @default([])
  platform        String
  adaptedContent  String?       @db.Text  // platform-specific adapted content
  scheduledFor    DateTime
  status          String        @default("scheduled")  // scheduled|published|failed|cancelled
  novaOptimised   Boolean       @default(false)
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  user          User         @relation(fields:[userId], references:[id], onDelete: Cascade)
  socialAccount SocialAccount? @relation(fields:[socialAccountId], references:[id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@map("social_scheduled_posts")
}

// ─────────────────────────────────────────────────────────────────────────────
// WINNERS COMMUNITY STUDIO — PHASE 2 EXTENSION
// Video Rooms, Broadcast Streams, Session Transcripts, Events Calendar
// ─────────────────────────────────────────────────────────────────────────────

model VideoRoom {
  id              String        @id @default(cuid())
  tenantId        String
  hostId          String
  title           String
  description     String?       @db.Text
  roomType        VideoRoomType @default(WORKSHOP)
  status          RoomStatus    @default(SCHEDULED)
  scheduledAt     DateTime?
  startedAt       DateTime?
  endedAt         DateTime?
  maxParticipants Int           @default(50)
  isPrivate       Boolean       @default(false)
  password        String?
  courseId        String?
  livekitRoomId   String?
  recordingUrl    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant                   @relation(fields: [tenantId], references: [id])
  host         User                     @relation(fields: [hostId], references: [id])
  participants VideoRoomParticipant[]
  breakouts    BreakoutRoom[]
  qaQuestions  QAQuestion[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([hostId, status])
  @@map("video_rooms")
}

model VideoRoomParticipant {
  id       String    @id @default(cuid())
  tenantId String
  roomId   String
  userId   String
  role     String    @default("participant")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?
  cameraOn Boolean   @default(false)
  micOn     Boolean   @default(false)

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  room   VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([roomId, userId])
  @@index([tenantId])
  @@index([roomId])
  @@map("video_room_participants")
}

model BreakoutRoom {
  id           String    @id @default(cuid())
  tenantId     String
  parentRoomId String
  name         String
  maxMembers   Int       @default(6)
  createdAt    DateTime  @default(now())
  endedAt      DateTime?

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  parentRoom VideoRoom @relation(fields: [parentRoomId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([parentRoomId])
  @@map("breakout_rooms")
}

enum VideoRoomType {
  WORKSHOP
  PANEL
  STUDY_GROUP
  MENTORSHIP
  TOWN_HALL
  REVENUE_ROOM
  CHALLENGE
}

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model BroadcastStream {
  id               String       @id @default(cuid())
  tenantId         String
  hostId           String
  title            String
  description      String?      @db.Text
  thumbnail        String?
  category         String?
  status           StreamStatus @default(SCHEDULED)
  scheduledAt      DateTime?
  startedAt        DateTime?
  endedAt          DateTime?
  muxStreamId      String?
  muxPlaybackId    String?
  rtmpKey          String       @unique @default(cuid())
  isPPV            Boolean      @default(false)
  ppvPrice         Float        @default(0)
  superChatEnabled Boolean      @default(true)
  peakViewers      Int          @default(0)
  totalViewers     Int          @default(0)
  totalRevenue     Float        @default(0)
  recordingUrl     String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  host      User           @relation(fields: [hostId], references: [id])
  viewers   StreamViewer[]
  superChats SuperChat[]
  ppvAccess PPVAccess[]

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([hostId, status])
  @@map("broadcast_streams")
}

model StreamViewer {
  id        String    @id @default(cuid())
  tenantId  String
  streamId  String
  userId    String
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  watchSecs Int       @default(0)

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stream BroadcastStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([streamId, userId])
  @@index([tenantId])
  @@index([streamId])
  @@map("stream_viewers")
}

model SuperChat {
  id          String    @id @default(cuid())
  tenantId    String
  streamId    String
  userId      String
  message     String    @db.Text
  amount      Float
  currency    String    @default("USD")
  stripeId    String
  pinnedUntil DateTime
  createdAt   DateTime  @default(now())

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stream BroadcastStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([streamId])
  @@map("super_chats")
}

model PPVAccess {
  id       String   @id @default(cuid())
  tenantId String
  streamId String
  userId   String
  paidAt   DateTime @default(now())
  amount   Float
  stripeId String

  tenant Tenant          @relation(fields: [tenantId], references: [id])
  stream BroadcastStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([streamId, userId])
  @@index([tenantId])
  @@map("ppv_access")
}

enum StreamStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model SessionTranscript {
  id             String    @id @default(cuid())
  tenantId       String
  sessionType    String
  sessionId      String    @unique
  rawTranscript  String    @db.Text
  novaSummary    String?   @db.Text
  novaHighlights Json?
  novaSkills     Json?
  qaLog          Json?
  wordCount      Int       @default(0)
  durationSecs   Int       @default(0)
  language       String    @default("en")
  createdAt      DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("session_transcripts")
}

model QAQuestion {
  id          String   @id @default(cuid())
  tenantId    String
  sessionId   String
  sessionType String
  userId      String
  question    String   @db.Text
  novaScore   Float    @default(0)
  upvotes     Int      @default(0)
  answered    Boolean  @default(false)
  answeredAt  DateTime?
  createdAt   DateTime @default(now())

  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoRoom  VideoRoom? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([sessionId, novaScore])
  @@map("qa_questions")
}

model StudioEvent {
  id           String   @id @default(cuid())
  tenantId     String
  hostId       String
  title        String
  description  String?  @db.Text
  sessionType  String
  sessionId    String?
  scheduledAt  DateTime
  durationMins Int      @default(60)
  rsvpCount    Int      @default(0)
  isPublic     Boolean  @default(true)
  thumbnail    String?
  tags         String[]
  createdAt    DateTime @default(now())

  tenant Tenant       @relation(fields: [tenantId], references: [id])
  host   User         @relation(fields: [hostId], references: [id])
  rsvps  StudioRsvp[]

  @@unique([id, tenantId])
  @@index([tenantId, scheduledAt])
  @@map("studio_events")
}

model StudioRsvp {
  id        String   @id @default(cuid())
  tenantId  String
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  tenant Tenant      @relation(fields: [tenantId], references: [id])
  event  StudioEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@unique([eventId, userId])
  @@index([tenantId])
  @@index([eventId])
  @@map("studio_rsvps")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 4: WINNERS MARKET — Commerce Hub (4A) + 10 Verticals
// ═══════════════════════════════════════════════════════════════════════════════

// Vendor - sellers on the marketplace
model Vendor {
  id              String    @id @default(cuid())
  tenantId        String
  userId          String
  storeName       String
  storeSlug       String    @unique
  description     String?   @db.Text
  logo            String?
  banner          String?
  verified        Boolean   @default(false)
  trustScore      Float     @default(0)
  totalSales      Int       @default(0)
  totalRevenue    Float     @default(0)
  payoutBalance   Float     @default(0)
  payoutMethod    String?
  stripeAccountId String?
  freeShipping    Boolean   @default(false)
  shippingPrice   Float     @default(0)
  taxRate         Float     @default(0)
  status          VendorStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  owner     User           @relation(fields: [userId], references: [id])
  products  Product[]
  orders    Order[]
  reviews   VendorReview[]

  @@index([tenantId])
  @@index([userId])
  @@unique([id, tenantId])
  @@map("vendors")
}

enum VendorStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
}

// Product - items for sale
model Product {
  id              String    @id @default(cuid())
  tenantId        String
  vendorId        String
  name            String
  slug            String
  description     String?   @db.Text
  price           Float
  comparePrice    Float?
  costPrice       Float?
  sku             String?
  barcode         String?
  category        String
  subcategory     String?
  tags            String[]
  brand           String?
  weight          Float?
  weightUnit      String?
  isDigital       Boolean   @default(false)
  isActive        Boolean   @default(true)
  isFeatured      Boolean   @default(false)
  stockQuantity    Int       @default(0)
  lowStockAlert   Int       @default(10)
  allowBackorder  Boolean   @default(false)
  shippingType    String?
  freeShipping    Boolean   @default(false)
  shippingPrice   Float?
  taxRate         Float?
  metaTitle       String?
  metaDescription String?
  viewCount       Int       @default(0)
  soldCount       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  vendor     Vendor           @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  variants   ProductVariant[]
  images    ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews   ProductReview[]

  @@unique([tenantId, slug])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([category])
  @@map("products")
}

// Product variants (size, color, etc.)
model ProductVariant {
  id            String   @id @default(cuid())
  tenantId      String
  productId     String
  name          String
  sku           String?
  price         Float
  comparePrice  Float?
  stockQuantity Int      @default(0)
  attributes    Json?
  imageUrl      String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([id, tenantId])
  @@unique([productId, sku])
  @@index([tenantId])
  @@index([productId])
  @@map("product_variants")
}

// Product images
model ProductImage {
  id        String   @id @default(cuid())
  tenantId  String
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([productId])
  @@map("product_images")
}

// Shopping cart
model Cart {
  id        String     @id @default(cuid())
  tenantId  String
  userId    String?
  sessionId String?
  status    CartStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  tenant Tenant     @relation(fields: [tenantId], references: [id])
  user   User?      @relation(fields: [userId], references: [id])
  items  CartItem[]

  @@unique([tenantId, sessionId])
  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

// Cart items
model CartItem {
  id          String   @id @default(cuid())
  tenantId    String
  cartId      String
  productId   String
  variantId   String?
  quantity    Int
  price       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([id, tenantId])
  @@unique([cartId, productId, variantId])
  @@index([tenantId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

// Order
model Order {
  id                  String       @id @default(cuid())
  tenantId            String
  userId              String
  vendorId            String
  orderNumber         String       @unique
  status              OrderStatus  @default(PENDING)
  subtotal            Float
  shippingCost        Float        @default(0)
  taxAmount           Float        @default(0)
  discountAmount      Float        @default(0)
  total               Float
  currency            String       @default("USD")
  shippingName        String?
  shippingAddress     String?      @db.Text
  shippingCity        String?
  shippingState       String?
  shippingZip         String?
  shippingCountry     String?
  shippingPhone       String?
  billingName         String?
  billingAddress      String?      @db.Text
  billingCity         String?
  billingState        String?
  billingZip          String?
  billingCountry      String?
  paymentMethod       String?
  paymentStatus       PaymentStatus @default(PENDING)
  stripePaymentId     String?
  stripeSessionId     String?
  stripePaymentIntentId String?
  stripeCustomerId   String?
  notes               String?      @db.Text
  metadata            Json?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  user     User        @relation(fields: [userId], references: [id])
  vendor   Vendor      @relation(fields: [vendorId], references: [id])
  items    OrderItem[]
  tracking OrderTracking?

  @@index([tenantId])
  @@index([userId])
  @@index([vendorId])
  @@index([orderNumber])
  @@unique([id, tenantId])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

// Order items
model OrderItem {
  id              String   @id @default(cuid())
  tenantId        String
  orderId         String
  productId       String
  variantId       String?
  name            String
  sku             String?
  quantity        Int
  price           Float
  total           Float
  createdAt       DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// Order tracking
model OrderTracking {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String   @unique
  carrier        String?
  trackingNumber String?
  trackingUrl    String?
  status         String?
  events         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([orderId])
  @@map("order_tracking")
}

// Product reviews
model ProductReview {
  id          String   @id @default(cuid())
  tenantId    String
  productId   String
  userId      String
  orderId     String?
  rating      Int
  title       String?
  content     String?  @db.Text
  images      String[]
  isVerified  Boolean  @default(false)
  isApproved  Boolean  @default(true)
  helpfulCount Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user   User    @relation(fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@unique([productId, userId])
  @@index([tenantId])
  @@index([productId])
  @@index([userId])
  @@map("product_reviews")
}

// Vendor reviews
model VendorReview {
  id          String   @id @default(cuid())
  tenantId    String
  vendorId    String
  userId      String
  orderId     String?
  rating      Int
  title       String?
  content     String?  @db.Text
  isVerified  Boolean  @default(false)
  isApproved  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  vendor Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([id, tenantId])
  @@unique([vendorId, userId])
  @@index([tenantId])
  @@index([vendorId])
  @@index([userId])
  @@map("vendor_reviews")
}

// ─── AI PLATFORM MODELS ───────────────────────────────────────────────────────
// AI Platform usage tracking
model AIPlatformUsage {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  action    String   // chat | image | speech | code
  model     String   // ollama | claude | comfyui | whisper
  tokens    Int      @default(0)
  cost      Float    @default(0)
  latencyMs Int
  createdAt DateTime @default(now())

  @@unique([id, tenantId])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@map("ai_platform_usage")
}

// AI Conversations (chat history)
model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  tenantId  String
  title     String      @default("New Conversation")
  model     String      @default("llama3.1")
  provider  String?    // ollama | claude | openai | gemini
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([id, tenantId])
  @@index([userId, updatedAt])
  @@index([tenantId, updatedAt])
  @@map("ai_conversations")
}

// AI Messages within conversations
model AIMessage {
  id             String         @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   AIConversation @relation(fields:[conversationId], references:[id], onDelete: Cascade)
  role           String         // user | assistant | system
  content        String         @db.Text
  provider       String?        // ollama | claude | openai | gemini
  model          String?
  tokensUsed     Int            @default(0)
  filesMeta      Json?
  createdAt      DateTime       @default(now())

  @@unique([id, tenantId])
  @@index([conversationId, createdAt])
  @@map("ai_messages")
}

// Assistant Memory - persistent memory per user per assistant
model AssistantMemory {
  id         String   @id @default(cuid())
  userId     String
  tenantId   String
  assistant  String   // omega | aria | nova | sage | atlas | forge | circuit | nexus | herald
  memoryType String   // user_profile | preference | journey | milestone | flag | skill | goal
  content    String   @db.Text
  confidence Float    @default(1.0)
  source     String?  // Which feature created this memory
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([id, tenantId])
  @@unique([userId, assistant, memoryType])
  @@index([userId, assistant])
  @@index([tenantId, assistant])
  @@map("assistant_memory")
}

// Assistant Actions - AI-initiated actions requiring approval or tracking
model AssistantAction {
  id           String    @id @default(cuid())
  tenantId     String
  assistant    String    // omega | aria | nova | sage | atlas | forge | circuit | nexus | herald
  actionType   String    // notify | escalate | recommend | trigger | generate | flag | onboard | match
  targetUserId String?
  targetLayer  String?   // community | academy | market | work | intelligence
  targetId     String?
  description  String    @db.Text
  payload      Json?
  status       String    @default("pending") // pending | approved | rejected | executed | failed
  approved     Boolean   @default(false)
  autoApproved Boolean   @default(false)
  executedAt   DateTime?
  result       String?   @db.Text
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([id, tenantId])
  @@index([assistant, status])
  @@index([targetUserId])
  @@index([tenantId])
  @@map("assistant_actions")
}

// Agentic Loop - tracks cross-layer automation flows
model AgenticLoop {
  id            String   @id @default(cuid())
  userId        String
  tenantId      String
  loopType      String   // skill_detection | course_recommendation | work_match | vendor_onboarding
  trigger       String   // What started this loop
  currentStep   Int      @default(0)
  steps         Json     // Array of step objects: { step, assistant, action, status }
  outcome       String?  @db.Text
  revenueImpact Float?
  status        String   // active | completed | failed | paused
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([id, tenantId])
  @@index([userId, status])
  @@index([tenantId, status])
  @@map("agentic_loops")
}

// AI Interaction - detailed log of every AI request
model AIInteraction {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  layer       String   // community | academy | market | work | intelligence | core
  agentType   String   // omega | aria | nova | sage | atlas | forge | circuit | nexus | herald
  input       String   @db.Text
  output      String?  @db.Text
  model       String?
  provider    String?
  tokens      Int      @default(0)
  latencyMs   Int
  cost        Float    @default(0)
  filesMeta   Json?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([id, tenantId])
  @@index([userId, createdAt])
  @@index([tenantId, createdAt])
  @@index([agentType, createdAt])
  @@map("ai_interactions")
}

// ═══════════════════════════════════════════════════════════════════════════════
// PHASE 6: WINNERS WORK — Freelance Marketplace & Jobs
// ═══════════════════════════════════════════════════════════════════════════════

// Job Listing - posted by clients
model JobListing {
  id              String        @id @default(cuid())
  tenantId        String
  clientId        String
  title           String
  description     String        @db.Text
  requirements    String?       @db.Text
  category        String        // software_dev | digital_marketing | creative | writing | finance | business | music | other
  skills          String[]
  experienceLevel String        // entry | mid | senior | expert
  jobType        String        // fixed | hourly
  budgetMin      Float?
  budgetMax      Float?
  currency       String        @default("USD")
  duration       String?       // weeks/months estimate
  location       String?       // remote | specific country/city
  deadline       DateTime?
  status         JobStatus     @default(OPEN)
  isFeatured     Boolean       @default(false)
  isVerified     Boolean       @default(false)
  viewCount      Int           @default(0)
  applicationCount Int         @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  expiresAt       DateTime?

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  client      User              @relation(fields: [clientId], references: [id])
  applications JobApplication[]
  contracts   Contract[]

  @@index([tenantId, status])
  @@index([clientId])
  @@index([category])
  @@index([createdAt])
  @@unique([id, tenantId])
  @@map("job_listings")
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
  DRAFT
}

// Freelancer Profile - talent's public profile
model FreelancerProfile {
  id              String           @id @default(cuid())
  userId          String           @unique
  tenantId        String
  title           String?          // e.g. "Senior React Developer"
  bio             String?          @db.Text
  hourlyRate      Float?
  availability    Availability    @default(AVAILABLE)
  yearsExperience Int?
  languages       String[]         @default(["English"])
  skills          String[]
  portfolioUrl    String?
  linkedInUrl     String?
  githubUrl       String?
  timezone        String?
  country         String?
  isVerified      Boolean          @default(false)
  trustScore      Float            @default(0)
  totalEarnings   Float            @default(0)
  totalJobs       Int              @default(0)
  successRate     Float            @default(0)
  responseTime    Int              @default(24) // hours
  badges          String[]         @default([])
  certificates    String[]         @default([]) // Academy certificate IDs
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user           User              @relation(fields: [userId], references: [id])
  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  applications   JobApplication[]
  contracts      Contract[]
  portfolioItems PortfolioItem[]

  @@index([tenantId])
  @@index([skills])
  @@index([availability])
  @@unique([id, tenantId])
  @@unique([userId, tenantId])
  @@map("freelancer_profiles")
}

enum Availability {
  AVAILABLE
  UNAVAILABLE
  BUSY
}

// Portfolio Items - freelancer's work samples
model PortfolioItem {
  id             String   @id @default(cuid())
  tenantId       String
  freelancerId   String
  title          String
  description    String?  @db.Text
  category       String?
  url            String?
  imageUrl       String?
  toolsUsed      String[]
  createdAt      DateTime @default(now())

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([freelancerId])
  @@map("portfolio_items")
}

// Job Application - freelancer applying to a job
model JobApplication {
  id            String             @id @default(cuid())
  tenantId      String
  jobId         String
  freelancerId  String
  coverLetter   String?            @db.Text
  proposedRate  Float?
  estimatedDays Int?
  status        ApplicationStatus @default(PENDING)
  cvUrl         String?
  portfolioUrls String[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  job        JobListing         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([jobId, freelancerId])
  @@index([tenantId])
  @@index([jobId])
  @@index([freelancerId])
  @@index([status])
  @@unique([id, tenantId])
  @@map("job_applications")
}

enum ApplicationStatus {
  PENDING
  SHORTLISTED
  INTERVIEWING
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

// Contract - hired relationship
model Contract {
  id              String          @id @default(cuid())
  tenantId        String
  jobId           String?
  clientId        String
  freelancerId    String
  title           String
  description     String?         @db.Text
  status          ContractStatus  @default(ACTIVE)
  startDate       DateTime
  endDate         DateTime?
  paymentType     String          // fixed | hourly
  amount          Float           // total for fixed, hourly rate for hourly
  currency        String          @default("USD")
  hoursLogged     Float           @default(0)
  hoursApproved   Float           @default(0)
  platformFee     Float           @default(0)
  clientRating    Float?
  freelancerRating Float?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  completedAt     DateTime?

  tenant     Tenant            @relation(fields: [tenantId], references: [id])
  job        JobListing?        @relation(fields: [jobId], references: [id], onDelete: SetNull)
  client     User               @relation("ClientContracts", fields: [clientId], references: [id])
  freelancer FreelancerProfile @relation(fields: [freelancerId], references: [id])
  milestones ContractMilestone[]
  escrow     EscrowPayment?
  reviews    WorkReview[]

  @@index([tenantId])
  @@index([clientId])
  @@index([freelancerId])
  @@index([status])
  @@unique([id, tenantId])
  @@map("contracts")
}

enum ContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  DISPUTED
}

// Contract Milestone - for fixed-price contracts
model ContractMilestone {
  id          String           @id @default(cuid())
  tenantId    String
  contractId  String
  title      String
  description String?          @db.Text
  amount      Float
  dueDate     DateTime?
  status      MilestoneStatus  @default(PENDING)
  completedAt DateTime?
  paidAt      DateTime?
  createdAt   DateTime         @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([contractId])
  @@map("contract_milestones")
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  APPROVED
  PAID
  DISPUTED
}

// Escrow Payment - secure payment handling
model EscrowPayment {
  id              String         @id @default(cuid())
  tenantId        String
  contractId      String         @unique
  amount          Float
  currency        String         @default("USD")
  status          EscrowStatus   @default(HELD)
  clientId        String
  freelancerId    String
  stripePaymentId String?
  releasedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([clientId])
  @@index([freelancerId])
  @@map("escrow_payments")
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

// Work Review - client/freelancer reviews
model WorkReview {
  id           String   @id @default(cuid())
  tenantId     String
  contractId   String
  reviewerId   String   // client or freelancer
  revieweeId   String   // freelancer or client
  rating       Float    // 1-5
  comment      String?  @db.Text
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([id, tenantId])
  @@index([tenantId])
  @@index([contractId])
  @@index([reviewerId])
  @@index([revieweeId])
  @@map("work_reviews")
}
