  tools                 String[]
  schedule              String?
  triggerEvent          String?
  maxRuntime            Int        @default(300)
  maxCreditsPerRun      Int        @default(100)
  humanApprovalRequired Boolean    @default(false)
  active                Boolean    @default(true)
  runCount              Int        @default(0)
  lastRunAt             DateTime?
  createdAt             DateTime   @default(now())
  runs                  AgentRun[]
  tenant                Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("ai_agents")
}

model AgentRun {
  id          String    @id @default(cuid())
  agentId     String
  status      String
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  reasoning   Json
  actionsLog  Json
  result      String?
  creditsUsed Int       @default(0)
  approved    Boolean?
  agent       AIAgent   @relation(fields: [agentId], references: [id])

  @@index([agentId])
  @@map("agent_runs")
}

model UsageLog {
  id       String   @id @default(cuid())
  tenantId String
  userId   String
  apiKeyId String?
  action   String
  credits  Int
  metadata Json?
  billedAt DateTime @default(now())
  apiKey   ApiKey?  @relation(fields: [apiKeyId], references: [id])
  tenant   Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, billedAt])
  @@map("usage_logs")
}

model SiteDeploy {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  domain     String?
  subdomain  String   @unique
  framework  String
  status     String
  url        String?
  sslActive  Boolean  @default(false)
  deployedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  tenant     Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@map("site_deploys")
}

model DNSZone {
  id        String      @id @default(cuid())
  tenantId  String
  domain    String      @unique
  verified  Boolean     @default(false)
  ns        String[]
  createdAt DateTime    @default(now())
  records   DNSRecord[]
  tenant    Tenant      @relation(fields: [tenantId], references: [id])

  @@map("dns_zones")
}

model DNSRecord {
  id        String   @id @default(cuid())
  zoneId    String
  type      String
  name      String
  value     String
  ttl       Int      @default(3600)
  priority  Int?
  createdAt DateTime @default(now())
  zone      DNSZone  @relation(fields: [zoneId], references: [id])

  @@index([zoneId])
  @@map("dns_records")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  token     String   @unique
  platform  String   @default("web")
  userAgent String?
  isActive  Boolean  @default(true)
  lastSeen  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
  @@map("device_tokens")
}

model VendorPayout {
  id               String    @id @default(cuid())
  tenantId         String
  vendorId         String
  orderId          String
  amount           Float
  commission       Float
  stripeTransferId String?
  status           String    @default("pending")
  createdAt        DateTime  @default(now())
  paidAt           DateTime?
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  vendor           Vendor    @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([vendorId])
  @@map("vendor_payouts")
}

// Winners Finance - Internal Settlement Rail
model UserWallet {
  id            String        @id @default(cuid())
  userId        String
  tenantId      String
  currency      String        @default("USD")
  balance       Float         @default(0)
  available     Float         @default(0)  // Available for withdrawal
  pending       Float         @default(0)  // Pending transactions
  totalEarned   Float         @default(0)  // Lifetime earnings
  totalSpent    Float         @default(0)  // Lifetime spending
  stripeAccountId String?
  mPesaNumber   String?       // Kenya mobile money
  bankAccount   String?       // Bank account for withdrawals
  bankName      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  transactions  WalletTransaction[]
  withdrawalRequests WithdrawalRequest[]

  @@unique([userId, tenantId])
  @@index([tenantId, userId])
  @@map("user_wallets")
}

model WalletTransaction {
  id            String        @id @default(cuid())
  walletId      String
  wallet        UserWallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type          String        // deposit, withdrawal, transfer, payment, refund, earned, fee
  amount        Float
  fee           Float         @default(0)
  netAmount     Float         // amount - fee
  currency      String        @default("USD")
  status        String        @default("pending") // pending, completed, failed, reversed
  description   String?
  reference     String?       // External reference (Stripe payment intent, order ID, etc.)
  relatedUserId String?       // For transfers: other user involved
  metadata      Json?
  createdAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([walletId, createdAt])
  @@index([walletId, type])
  @@index([relatedUserId])
  @@map("wallet_transactions")
}

model WithdrawalRequest {
  id            String        @id @default(cuid())
  userId        String
  tenantId      String
  walletId      String
  amount        Float
  fee           Float         @default(0)
  netAmount     Float         // amount - fee
  method        String        // stripe, mpesa, bank
  status        String        @default("pending") // pending, processing, completed, failed, cancelled
  payoutId      String?        // External payout ID
  failureReason String?
  createdAt     DateTime      @default(now())
  processedAt   DateTime?
  user          User          @relation(fields: [userId], references: [id])
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  wallet        UserWallet    @relation(fields: [walletId], references: [id])

  @@index([userId, status])
  @@index([tenantId, status])
  @@map("withdrawal_requests")
}

// ========== SAVINGS GROUPS / CHAMA ==========

model SavingsGroup {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String   @default("")
  contributionAmount Float
  frequency         String   // weekly, biweekly, monthly
  maxMembers        Int      @default(10)
  currency          String   @default("USD")
  status            String   @default("active") // active, completed, cancelled
  currentRound      Int      @default(1)
  totalPool         Float    @default(0)
  createdBy         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  members           SavingsGroupMember[]
  contributions     SavingsGroupContribution[]
  payouts           SavingsGroupPayout[]

  @@index([tenantId])
  @@index([status])
  @@map("savings_groups")
}

model SavingsGroupMember {
  id                String   @id @default(cuid())
  groupId           String
  userId            String
  role              String   @default("member") // admin, member
  payoutOrder       Int
  totalContributed  Float    @default(0)
  hasReceivedPayout Boolean  @default(false)
  joinedAt          DateTime @default(now())
  group             SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("savings_group_members")
}

model SavingsGroupContribution {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  amount    Float
  round     Int
  status    String   @default("completed")
  createdAt DateTime @default(now())
  group     SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, round])
  @@index([userId])
  @@map("savings_group_contributions")
}

model SavingsGroupPayout {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  amount    Float
  round     Int
  status    String   @default("completed")
  createdAt DateTime @default(now())
  group     SavingsGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, round])
  @@index([userId])
  @@map("savings_group_payouts")
}

model PlatformLayerStatus {
  id               String   @id @default(cuid())
  layerId          String
  layerName        String
  status           String
  actorUserId      String?
  actorEmail       String?
  confirmationText String?
  summary          String?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([layerId, createdAt])
  @@map("platform_layer_statuses")
}

